{
  "steps": [
    { "snapshot": "hub" },
    { "click": "#card-1" },
    { "snapshot": "chapter-1" },
    { "click": "#back-1" },
    { "snapshot": "back-1" },
    { "click": "#card-2" },
    { "snapshot": "chapter-2" },
    { "key": "Escape" },
    { "snapshot": "back-2" },
    { "click": "#card-3" },
    { "snapshot": "tour" },
    { "seek": 8 },
    { "snapshot": "tour-target" },
    { "click": "#back-3" },
    { "snapshot": "back-3" }
  ],
  "assertions": [
    { "after": "hub", "timeline": "Hub" },
    { "after": "hub", "selector": "#hub", "visible": true },
    { "after": "hub", "selector": "#hub-title", "text": "Port" },
    { "after": "hub", "selector": "#card-3", "controllers": ["DOMEventListenerController"] },

    { "after": "chapter-1", "timeline": "Chapter 1" },
    { "after": "chapter-1", "selector": "#hub", "visible": false },
    { "after": "chapter-1", "selector": "#chapter-1", "visible": true },
    { "after": "chapter-1", "selector": "#card-1", "controllers": [] },
    { "after": "chapter-1", "selector": "#hub-title", "controllers": [] },
    { "after": "chapter-1", "selector": "#back-1", "controllers": ["DOMEventListenerController"] },
    {
      "after": "chapter-1",
      "selector": "#stage",
      "controllers": ["KeyboardController", "KeyboardController"]
    },
    { "after": "back-1", "timeline": "Hub" },
    { "after": "back-1", "selector": "#hub", "visible": true },
    { "after": "back-1", "selector": "#chapter-1", "visible": false },
    { "after": "back-1", "selector": "#back-1", "controllers": [] },
    { "after": "back-1", "selector": "#stage", "controllers": [] },
    { "after": "back-1", "selector": "#card-1", "controllers": ["DOMEventListenerController"] },
    { "after": "back-1", "selector": "#card-2", "controllers": ["DOMEventListenerController"] },
    { "after": "back-1", "selector": "#card-3", "controllers": ["DOMEventListenerController"] },
    { "after": "back-1", "selector": "#hub-title", "controllers": ["LabelController"] },

    { "after": "chapter-2", "timeline": "Chapter 2" },
    { "after": "chapter-2", "selector": "#chapter-2", "visible": true },
    { "after": "chapter-2", "selector": "#back-2", "controllers": ["DOMEventListenerController"] },
    { "after": "chapter-2", "selector": "#stage", "controllers": ["KeyboardController"] },
    { "after": "back-2", "timeline": "Hub" },
    { "after": "back-2", "selector": "#chapter-2", "visible": false },
    { "after": "back-2", "selector": "#back-2", "controllers": [] },
    { "after": "back-2", "selector": "#stage", "controllers": [] },
    { "after": "back-2", "selector": "#card-1", "controllers": ["DOMEventListenerController"] },
    { "after": "back-2", "selector": "#card-2", "controllers": ["DOMEventListenerController"] },
    { "after": "back-2", "selector": "#card-3", "controllers": ["DOMEventListenerController"] },
    { "after": "back-2", "selector": "#hub-title", "controllers": ["LabelController"] },

    { "after": "tour", "timeline": "Timeline & Time" },
    { "after": "tour", "selector": "#chapter-3", "visible": true },
    { "after": "tour", "selector": "#c3-title", "text": "Timeline & Time" },
    { "after": "tour", "selector": "#c3-intro", "text": "An Eligian presentation is one or more timelines." },
    { "after": "tour", "selector": "#c3-title", "controllers": ["LabelController"] },
    { "after": "tour", "selector": "#c3-intro", "controllers": ["LabelController"] },
    { "after": "tour", "selector": "#back-3", "controllers": ["DOMEventListenerController"] },
    {
      "after": "tour",
      "selector": "#stage",
      "controllers": ["KeyboardController", "KeyboardController"]
    },
    { "after": "tour-target", "position": 8 },
    { "after": "tour-target", "selector": "#c3-box", "hasClass": "is-lit" },
    { "after": "tour-target", "selector": "#c3-beat-2", "notHasClass": "is-visible" },
    { "after": "tour-target", "selector": "#c3-beat-3", "notHasClass": "is-visible" },
    { "after": "back-3", "timeline": "Hub" },
    { "after": "back-3", "selector": "#hub", "visible": true },
    { "after": "back-3", "selector": "#chapter-3", "visible": false },
    { "after": "back-3", "selector": "#c3-title", "controllers": [] },
    { "after": "back-3", "selector": "#c3-intro", "controllers": [] },
    { "after": "back-3", "selector": "#back-3", "controllers": [] },
    { "after": "back-3", "selector": "#stage", "controllers": [] },
    { "after": "back-3", "selector": "#card-1", "controllers": ["DOMEventListenerController"] },
    { "after": "back-3", "selector": "#card-2", "controllers": ["DOMEventListenerController"] },
    { "after": "back-3", "selector": "#card-3", "controllers": ["DOMEventListenerController"] },
    { "after": "back-3", "selector": "#hub-title", "controllers": ["LabelController"] }
  ]
