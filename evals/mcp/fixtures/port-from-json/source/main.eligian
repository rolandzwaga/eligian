languages {
  * "en-US" "English"
    "nl-NL" "Nederlands"
}

layout "./layout.html"
styles "./styles.css"
locales "./locales.json"

/** Show a view: selects it and adds .is-active */
action showView(selector: string) [
  selectElement(selector)
  addClass("is-active")
]

/** Hide a view again */
action hideView(selector: string) [
  selectElement(selector)
  removeClass("is-active")
]

action reveal(selector: string) [
  selectElement(selector)
  addClass("is-visible")
]

action conceal(selector: string) [
  selectElement(selector)
  removeClass("is-visible")
]

// The hub: a menu of chapters. It has no timed events, so it waits for a click.
timeline "Hub" in "#stage" using raf {
  on enter [
    showView("#hub")
    selectElement("#hub-title")
    addController("LabelController", "hub.title")
    on click "#card-1" navigate "Chapter 1"
    on click "#card-2" navigate "Chapter 2"
    on click "#card-3" navigate "Timeline & Time"
  ]
  // on leave removes every controller on enter added
  on leave [
    hideView("#hub")
    selectElement("#card-1")
    removeControllerFromElement("DOMEventListenerController")
    selectElement("#card-2")
    removeControllerFromElement("DOMEventListenerController")
    selectElement("#card-3")
    removeControllerFromElement("DOMEventListenerController")
    selectElement("#hub-title")
    removeControllerFromElement("LabelController")
  ]
}

timeline "Chapter 1" in "#stage" using raf {
  on enter [
    showView("#chapter-1")
    on click "#back-1" navigate "Hub"
    on key "Escape" navigate "Hub"
    // The right arrow skips to the second beat (a label of this timeline)
    on key "ArrowRight" seek second.start
  ]
  on leave [
    hideView("#chapter-1")
    selectElement("#back-1")
    removeControllerFromElement("DOMEventListenerController")
    // One KeyboardController per on key, on the timeline's container
    selectElement("#stage")
    removeControllerFromElement("KeyboardController")
    removeControllerFromElement("KeyboardController")
  ]

  at 0s for 4s as first [ reveal("#c1-beat-1") ] [ conceal("#c1-beat-1") ]
  at first.end for 4s as second [ reveal("#c1-beat-2") ] [ conceal("#c1-beat-2") ]
}

timeline "Chapter 2" in "#stage" using raf {
  on enter [
    showView("#chapter-2")
    on click "#back-2" navigate "Hub"
    on key "Escape" navigate "Hub"
  ]
  on leave [
    hideView("#chapter-2")
    selectElement("#back-2")
    removeControllerFromElement("DOMEventListenerController")
    selectElement("#stage")
    removeControllerFromElement("KeyboardController")
  ]

  at 0s for 4s [ reveal("#c2-beat-1") ] [ conceal("#c2-beat-1") ]
}

// A chapter of the Eligian tour (Chapter 01, Timeline & Time): its beats are timed
// with a program-level time constant and labelled events, and one beat uses target.
const beat = 3s

timeline "Timeline & Time" in "#stage" using raf {
  on enter [
    showView("#chapter-3")
    selectElement("#c3-title")
    addController("LabelController", "tour.title")
    selectElement("#c3-intro")
    addController("LabelController", "tour.intro")
    on click "#back-3" navigate "Hub"
    on key "Escape" navigate "Hub"
    on key "space" toggle
  ]
  on leave [
    hideView("#chapter-3")
    selectElement("#c3-title")
    removeControllerFromElement("LabelController")
    selectElement("#c3-intro")
    removeControllerFromElement("LabelController")
    selectElement("#back-3")
    removeControllerFromElement("DOMEventListenerController")
    selectElement("#stage")
    removeControllerFromElement("KeyboardController")
    removeControllerFromElement("KeyboardController")
  ]

  at 0s for @beat as open [ reveal("#c3-beat-1") ] [ conceal("#c3-beat-1") ]
  at open.end for @beat as ranges [ reveal("#c3-beat-2") ] [ conceal("#c3-beat-2") ]
  at ranges.end for 4s as targets target "#c3-box" [ addClass("is-lit") ] [ removeClass("is-lit") ]
  at targets.end for @beat as recap [ reveal("#c3-beat-3") ] [ conceal("#c3-beat-3") ]
}
