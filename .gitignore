.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
node_modules/
dist/
out/
**/src/generated
**/*.generated.ts
packages/extension/syntaxes/
*.tsbuildinfo
*.vsix
/.claude/settings.local.json

# serena
.serena/

# pnpm
.pnpm-store/
.pnpm-debug.log

# fallow tool cache
.fallow/
**/.fallow/

# Debug and temporary files (Constitution VIII)
*.orig
*.js
*.js.map
packages/**/*.d.ts
debug-*.mjs
debug-*.ts
test-*.js
test-*.mjs
check-*.js
check-*.mjs
*.log
!**/__fixtures__/**/*.log
.DS_Store
/packages/cli/coverage
/packages/language/coverage
/packages/shared-utils/coverage
# vitest 5 cache and --shard blob reports (CI merges those: ci.yml cli-tests / cli-coverage)
.vitest/
/TODO.txt
/nul
/examples/nul
/coverage/coverage-final.json

# Eligian Tour — compiled Eligius config (build artifact)
/examples/eligian-tour/tour.json

# Copied in by the extension and CLI builds (the Marketplace and npm pages show them); npm pack output
packages/extension/LICENSE
packages/extension/CHANGELOG.md
packages/cli/LICENSE
packages/cli/*.tgz

# Claude Code workflows are source (the *.js rule above is for build output)
!/.claude/workflows/*.js

# Eval runs (pnpm evals:mcp): local output, never committed
evals/mcp/results/*
!evals/mcp/results/.gitkeep
