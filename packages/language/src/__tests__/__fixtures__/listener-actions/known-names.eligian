layout "./layout.html"

endable action greet [
  selectElement("#go")
] [
  selectElement("#go")
]

timeline "Main" in "#stage" using raf {
  on enter [
    selectElement("#go")
    addController("DOMEventListenerController", "click", ["greet", "end:greet"])
  ]
  on leave [
    selectElement("#go")
    removeControllerFromElement("DOMEventListenerController")
  ]
}
