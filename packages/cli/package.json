{
  "name": "eligian",
  "description": "Compiler and command line for Eligian, a concise DSL for Eligius presentations: check, compile, bundle, play and format .eligian files.",
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Roland Zwaga",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rolandzwaga/eligian.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/rolandzwaga/eligian/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/rolandzwaga/eligian/issues"
  },
  "keywords": [
    "eligian",
    "eligius",
    "dsl",
    "compiler",
    "cli",
    "presentation",
    "timeline",
    "storytelling"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "bin/cli.js",
    "dist/cli.mjs",
    "dist/docs/**"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "eligian": "./bin/cli.js",
    "eligian-cli": "./bin/cli.js"
  },
  "scripts": {
    "clean": "shx rm -fr *.tsbuildinfo out dist coverage LICENSE *.tgz",
    "build": "shx cp -f ../../LICENSE ./LICENSE && node esbuild.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "build:prod": "shx cp -f ../../LICENSE ./LICENSE && node esbuild.mjs --production",
    "prepack": "pnpm run build:prod",
    "generate:knowledge": "tsx scripts/generate-knowledge.ts --out dist/docs",
    "rank:diagnostic-codes": "tsx scripts/rank-diagnostic-codes.ts",
    "build:clean": "pnpm run clean && pnpm run build",
    "test": "vitest run --exclude src/__tests__/package-bin.spec.ts && pnpm run test:bin",
    "test:coverage:ci": "vitest run --coverage --exclude src/__tests__/package-bin.spec.ts && pnpm run test:bin",
    "test:bin": "vitest run src/__tests__/package-bin.spec.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chalk": "6.0.1",
    "commander": "15.0.0",
    "effect": "4.0.7",
    "eligius": "4.2.0",
    "esbuild": "0.28.2",
    "jquery": "4.0.0",
    "tinyglobby": "0.2.17",
    "jsdom": "30.1.3"
  },
  "devDependencies": {
    "@eligian/language": "workspace:*",
    "@modelcontextprotocol/inspector": "2.13.0",
    "@types/jsdom": "30.0.0",
    "tsx": "4.23.15"
  }
}
