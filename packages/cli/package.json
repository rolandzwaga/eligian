{
  "name": "@eligian/cli",
  "description": "Eligian DSL compiler CLI and library - compile .eligian files to Eligius JSON",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "bin",
    "dist",
    "out"
  ],
  "main": "./dist/index.mjs",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "bin": {
    "eligian": "./bin/cli.js",
    "eligian-cli": "./bin/cli.js"
  },
  "scripts": {
    "clean": "shx rm -fr *.tsbuildinfo out dist",
    "build": "node esbuild.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "build:clean": "pnpm run clean && pnpm run build",
    "test": "vitest run",
    "test:coverage:ci": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@eligian/language": "workspace:*",
    "chalk": "6.0.1",
    "commander": "15.0.0",
    "effect": "4.0.5",
    "eligius": "4.1.0",
    "esbuild": "0.28.2",
    "jquery": "4.0.0",
    "tinyglobby": "0.2.17",
    "jsdom": "30.1.3"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0"
  }
}
