// Determinism: a click handler adds a class nothing removes; nobody clicks, the ranges invert
layout "./layout.html"
styles "./styles.css"

action mark() [
  selectElement("#box")
  addClass("marked")
]

timeline "main" in "#stage" using raf {
  on enter [
    on click "#btn" run mark()
  ]
  at 1s..3s [
    selectElement("#box")
    addClass("in")
  ] [
    selectElement("#box")
    removeClass("in")
  ]
  at 0s..5s [ log("playing") ] []
}
