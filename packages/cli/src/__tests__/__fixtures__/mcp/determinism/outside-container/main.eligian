// Determinism: the range adds class "in" to #outside, outside the timeline's container, and never removes it
layout "./layout.html"
styles "./styles.css"

timeline "main" in "#stage" using raf {
  at 1s..3s [
    selectElement("#box")
    addClass("in")
  ] [
    selectElement("#box")
    removeClass("in")
  ]
  at 1s..3s [
    selectElement("#outside")
    addClass("in")
  ] []
  at 0s..5s [ log("playing") ] []
}
