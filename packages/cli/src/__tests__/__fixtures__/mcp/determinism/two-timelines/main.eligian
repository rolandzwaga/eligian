// Determinism: each timeline adds class "in" to its own box and never removes it
layout "./layout.html"
styles "./styles.css"

timeline "first" in "#stage" using raf {
  at 1s..3s [
    selectElement("#first-box")
    addClass("in")
  ] []
  at 0s..5s [ log("first") ] []
}

timeline "second" in "#stage" using raf {
  at 1s..3s [
    selectElement("#second-box")
    addClass("in")
  ] []
  at 0s..5s [ log("second") ] []
}
