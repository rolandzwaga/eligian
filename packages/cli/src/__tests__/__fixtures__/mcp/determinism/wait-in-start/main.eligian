// Determinism: the range waits 300 ms before it adds class "in"; its end block removes it
layout "./layout.html"
styles "./styles.css"

timeline "main" in "#stage" using raf {
  at 1s..3s [
    wait(300)
    selectElement("#box")
    addClass("in")
  ] [
    selectElement("#box")
    removeClass("in")
  ]
  at 0s..5s [ log("playing") ] []
}
