// media-timeline-first-without-start-gesture negative: a click on #start plays the video
layout "./layout.html"
styles "./styles.css"

timeline "Clip" in "#player" using video from "./media/clip.mp4" {
  on enter [
    on click "#start" play
  ]
  on leave [
    selectElement("#start")
    removeControllerFromElement("DOMEventListenerController")
  ]
}
