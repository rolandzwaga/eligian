// SC-021 (mcp-paths.spec.ts): the project root is outside/inner, and the stylesheet is imported
// from outside it through ../ (FR-058). A mistyped className: unknown_css_class, suggesting lit
layout "./layout.html"
styles "../shared.css"

timeline "main" in "#stage" using raf {
  at 0s..1s [ selectElement("#box") addClass("lti") ] [ selectElement("#box") removeClass("lit") ]
}
