// Scenario key target, the KeyboardController element: "x" only works inside #panel
layout "./layout.html"
styles "./styles.css"

action mark() [
  selectElement("#panel")
  addClass("on")
]

timeline "main" in "#stage" using raf {
  on enter [
    on key "x" in "#panel" run mark()
  ]
  at 0s..30s [ log("playing") ] []
}
