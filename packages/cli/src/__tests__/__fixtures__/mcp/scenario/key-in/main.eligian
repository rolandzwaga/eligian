// Scenario key target, `in`: "x" in #a marks #a, "x" in #b marks #b
layout "./layout.html"
styles "./styles.css"

action markA() [
  selectElement("#a")
  addClass("on")
]

action markB() [
  selectElement("#b")
  addClass("on")
]

timeline "main" in "#stage" using raf {
  on enter [
    on key "x" in "#a" run markA()
    on key "x" in "#b" run markB()
  ]
  at 0s..30s [ log("playing") ] []
}
