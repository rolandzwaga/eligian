// Scenario media timeline: navigating to the video timeline runs on the fake media clock (FR-037)
layout "./layout.html"

timeline "main" in "#stage" using raf {
  at 0s..30s [ log("playing") ] []
}

timeline "film" in "#stage" using video from "./media/film.mp4" {
  at 0s..5s [ log("film") ] []
}
