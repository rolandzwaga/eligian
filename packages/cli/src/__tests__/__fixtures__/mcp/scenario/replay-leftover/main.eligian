// Scenario domEquals: #restart only seeks to 0, so the class "seen" the timeline left stays set
layout "./layout.html"
styles "./styles.css"

timeline "main" in "#stage" using raf {
  on enter [
    on click "#restart" seek 0s
  ]
  at 2s..8s [
    selectElement("#box")
    addClass("in")
  ] [
    selectElement("#box")
    removeClass("in")
  ]
  at 10s..20s [
    selectElement("#box")
    addClass("seen")
  ] []
}
