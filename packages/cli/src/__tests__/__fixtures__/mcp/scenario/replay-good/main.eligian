// Scenario domEquals: #restart removes what the timeline left behind, then seeks to 0
layout "./layout.html"
styles "./styles.css"

action reset() [
  selectElement("#box")
  removeClass("seen")
]

timeline "main" in "#stage" using raf {
  on enter [
    on click "#restart" run reset()
    on click "#restart" seek 0s
  ]
  at 2s..8s [
    selectElement("#box")
    addClass("in")
  ] [
    selectElement("#box")
    removeClass("in")
  ]
  at 10s..20s [
    selectElement("#box")
    addClass("seen")
  ] []
}
