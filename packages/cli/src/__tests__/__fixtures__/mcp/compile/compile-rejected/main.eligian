// A program that validation rejects (spec 058 phase 2, SC-004(4), T006 ruling):
// locales.json is JSON but not a locales file, so `check` reports
// locales-import-error and `compile` throws a CompilationError before any
// AssetError branch. It imports a library so the release test can count documents.
languages { * "en-US" "English" }
layout "./layout.html"
locales "./locales.json"
import { fade } from "./lib/anim.eligian"

timeline "main" in "#stage" using raf {
  at 0s..1s fade("#title")
}
