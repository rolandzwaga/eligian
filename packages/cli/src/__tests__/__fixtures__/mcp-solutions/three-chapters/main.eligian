  on enter [
    showView("#results")
    label("#results-title", "results.title")
    label("#results-text", "results.text")
    on click "#back-results" navigate "Hub"
  ]
  on leave [
    hideView("#results")
    unlabel("#results-title")
    unlabel("#results-text")
    selectElement("#back-results")
