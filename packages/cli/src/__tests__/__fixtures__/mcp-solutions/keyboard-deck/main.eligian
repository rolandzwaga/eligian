layout "./layout.html"
styles "./styles.css"

/** Shows a slide and writes its number into the counter */
action showSlide(slide: string, number: string) [
  selectElement(slide)
  addClass("is-active")
  selectElement("#counter")
  setElementContent(number)
]

/** Hides a slide */
action hideSlide(slide: string) [
  selectElement(slide)
  removeClass("is-active")
]

timeline "slide-1" in "#deck" using raf {
  on enter [
    showSlide("#slide-1", "1 / 12")
    on key "ArrowRight" navigate "slide-2"
  ]
  on leave [
    hideSlide("#slide-1")
    // on enter put one KeyboardController per key on #deck
    selectElement("#deck")
    removeControllerFromElement("KeyboardController")
  ]
  at 0s..1s target "#slide-1" [ addClass("is-entering") ] [ removeClass("is-entering") ]
}

