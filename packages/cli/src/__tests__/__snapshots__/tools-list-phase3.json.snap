  {
    "name": "eligian_operations",
    "description": "Look up Eligian operations BEFORE calling one you have not used yet: each card starts with NEEDS / PROVIDES / ERASES (the operationData an operation reads, writes and removes), then its parameters, the call form and the description. `names` batches lookups; an unknown name comes back with suggestions. Filters `query` (name contains), `category`, `needs` and `provides` intersect. `kind` lists the other names: `controller` (with status), `event` (timeline events), `dom-event`, `key`. `path` (an .eligian file) adds the host operations, controllers and functions its `extensions` import declares. No argument: the operation names by category. At most 25 cards per call; the rest are named in `notReturned`.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "query": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "needs": {
          "type": "string"
        },
        "provides": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "operation",
            "controller",
            "event",
            "dom-event",
            "key"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "header": {
          "type": "string"
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "kind",
              "text"
            ],
            "additionalProperties": true
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "suggestions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "suggestions"
            ],
            "additionalProperties": true
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "description"
            ],
            "additionalProperties": true
          }
        },
        "categories": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "notReturned": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "see": {
          "type": "string"
        }
      },
      "required": [
        "header",
        "cards",
        "unknown"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    },
    "_meta": {
      "anthropic/alwaysLoad": true
    }
  },
  {
    "name": "eligian_check",
    "description": "Check Eligian (.eligian) files: every diagnostic of the compiler, Eligius lint and the review pass (controllers never removed, classes never removed). Run it after EVERY edit until it reports 0 errors and 0 warnings (`ok: true`). Each diagnostic carries its fix: `suggestions`, a `quickFix` (replace the 1-based range with `newText`), the source `excerpt`, and the cause + fix text of its `docs` overlay (inlined once per code). `paths` takes files, directories and globs under the project root. The defaults are stricter than the CLI `eligian check`: `lint: true`, `review: true`, `selectorNotInLayout: 'ids'` (an id in the CSS but not in the layout HTML is reported) and `maxWarnings: 0`.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "selectorNotInLayout": {
          "type": "string",
          "enum": [
            "off",
            "ids",
            "all"
          ]
        },
        "lint": {
          "type": "boolean"
        },
        "review": {
          "type": "boolean"
        },
        "maxWarnings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "paths"
      ],
      "additionalProperties": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "header": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "root": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "errors": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "warnings": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "file",
              "errors",
              "warnings"
            ],
            "additionalProperties": true
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "parser",
                  "validator",
                  "type",
                  "linker",
                  "compiler",
                  "eligius-lint",
                  "review",
                  "fmt",
                  "smoke"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "info",
                  "hint"
                ]
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "column": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "endLine": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "endColumn": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "excerpt": {
                "type": "string"
              },
              "suggestions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "quickFix": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "column": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "endLine": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "endColumn": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "newText": {
                    "type": "string"
                  }
                },
                "required": [
                  "line",
                  "column",
                  "endLine",
                  "endColumn",
                  "newText"
                ],
                "additionalProperties": true
              },
              "docs": {
                "type": "string"
              },
              "fix": {
                "type": "string"
              },
              "timeline": {
                "type": "string"
              },
              "time": {
                "type": "number"
              },
              "step": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "expected": {
                "type": "string"
              },
              "actual": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "severity",
              "code",
              "message",
              "file",
              "line",
              "column",
              "excerpt"
            ],
            "additionalProperties": true
          }
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "header",
        "ok",
        "root",
        "files",
        "diagnostics",
        "summary"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
    },
    "_meta": {
      "anthropic/alwaysLoad": true
    }
  },
  {
    "name": "eligian_fmt",
    "description": "Format Eligian (.eligian) files with the rules of the editor and `eligian fmt`. By default this only checks: each file reports `formatted` and, when it is not, a `lineDiff` of the lines that would change; nothing is written. With `write: true` the unformatted files are rewritten in place and `written` lists their absolute paths (files already formatted are left alone and not listed). A file with syntax errors gets `error` and is never written: fix it first (`eligian_check` names the problem). `paths` takes files, directories and globs under the project root; formatting changes whitespace only, so running it twice is a no-op.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "write": {
          "type": "boolean"
        }
      },
      "required": [
        "paths"
      ],
      "additionalProperties": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "header": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "formatted": {
                "type": "boolean"
              },
              "lineDiff": {
                "type": "string"
              },
              "error": {
                "type": "string"
              }
            },
            "required": [
              "file",
              "formatted"
            ],
            "additionalProperties": true
          }
        },
        "written": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "header",
        "files",
        "written"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "eligian_init",
    "description": "Scaffold a new Eligian presentation project from a starter template (blank, chapters, video, library) in a directory: main.eligian, layout, CSS, locales, package.json, plus the agent files of each client. client: claude, cursor, vscode, codex (default [\"claude\"]): claude gets .mcp.json and CLAUDE.md, cursor .cursor/mcp.json and .cursor/rules/eligian.mdc, vscode .vscode/mcp.json and .github/copilot-instructions.md, codex .codex/config.toml, and every client the AGENTS.md block; agents: false writes none. Existing agent files are merged: only the eligian server entry and the marked eligian block change. Each agent file is reported as written, updated, unchanged or refused (invalid JSON is left untouched). Existing starter files are refused unless force: true. The reply lists the files written and the next steps (npm install first).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string"
        },
        "template": {
          "type": "string",
          "enum": [
            "blank",
            "chapters",
            "video",
            "library"
          ]
