                        "minimum": 0
                      }
                    },
                    "required": [
                      "wait"
                    ],
                    "additionalProperties": true
                  },
                  {
                    "type": "object",
                    "properties": {
                      "snapshot": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "snapshot"
                    ],
                    "additionalProperties": true
                  }
                ]
              }
            },
            {
              "type": "object",
              "properties": {
                "steps": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "seek": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "seek"
                        ],
