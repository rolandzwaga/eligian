/**
 * Eligian Tour — single-file entry (hub + chapters).
 *
 * The whole presentation compiles to ONE Eligius config: a hub menu plus every
 * chapter, each as its own `timeline`. The engine renders the shared layout once
 * and switches between timelines when a card (or the back button) is clicked —
 * that click→switch is the `navigate` sugar, which compiles to a
 * DOMEventListenerController that broadcasts `request-timeline-uri`.
 *
 * VIEW MANAGEMENT — each timeline shows ONLY its own view, through its
 * lifecycle blocks:
 *   on enter → enterChapter(self) (show + progress bar) + wire nav and keys
 *   on leave → leaveChapter(self, back) (hide, reset the view, unwire)
 * replay (r) → replayChapter(self): reset the view, then seek to 0.
 * The engine's switch lifecycle runs the leaving timeline's `on leave`, then the
 * entering timeline's `on enter`, so no timeline needs to hide the others. They
 * are not events: the view stays up after the last beat, and the timeline's
 * duration is its last beat's end. (See ELIGIUS_EXECUTION_MODEL.md §7b.)
 * `#narration` is a shared subtitle bar each chapter shows/hides alongside its
 * own view. Keyboard: 1–8 on the hub, Esc back, space pauses, r replays.
 *
 * Snippets in the code pane are hand-authored display assets (pre-tokenized in
 * layout.html); this file is the real machinery driving them.
 */
languages {
  * "en-US" "English"
    "nl-NL" "Nederlands"
}

layout "./layout.html"
styles "./tour.css"
locales "./locales.json"

import { revealBlock, spotlight, clearSpots, callout, narrate, demo, revealCard, showView, hideView, enterChapter, replayChapter, leaveChapter } from "./presentation.eligian"

// Chapter-3 helpers: the executed code mirrors the taught snippets.
// House rule: const lives in actions (or at program level), not in timeline
// blocks, so the loop and the conditional live here.
action ch3Badge(count) [
  // count is a runtime parameter, so this emits a real when / otherwise / endWhen
  selectElement("#c3-badge")
  if (count > 0) {
    removeClass("muted")
    addClass("active")
  } else if (count == 0) {
    removeClass("active")
    addClass("muted")
  } else {
    removeClass("active")
    removeClass("muted")
  }
]

action ch3RevealBullets() [
  const points = ["#c3-b1", "#c3-b2", "#c3-b3"]   // folded into forEach's collection
  for (p in @points) {
    selectElement(@@p)                           // the loop item (= @@currentItem)
    addClass("in")
  }
]

action ch3LoopControl() [
  const numbers = [0, 3, 7, 12]
  for (n in @numbers) {
    if (@@n == 0) { continue }                   // continueForEach
    if (@@n > 9) { break }                       // breakForEach
    with "#c3-n-" + @@n { addClass("lit") }      // runtime concat: "#c3-n-3", "#c3-n-7"
  }
]

// Chapter-5 helpers — a REAL eventbus round-trip the chapter wires live. Clicking
// the button runs ch5BroadcastPing (attached via a DOMEventListenerController),
// which broadcasts "tour-ping"; the `on event` handler below catches it and reveals
// the panel. This dogfoods three engine-reach features at once: controllers, the
// eventbus, and event-driven actions — the same path the `navigate` sugar uses.
action ch5WireButton() [
  selectElement("#c5-fx-ping")
  // addController(name, ...controllerParams) — positional after the name. For
  // DOMEventListenerController: eventName, then the actions to run on the event.
  addController("DOMEventListenerController", "click", ["ch5BroadcastPing"])
]

action ch5BroadcastPing() [
  // broadcastEvent's params are (eventArgs, eventName) in that order — the array
  // first. eventArgs[0] ("#c5-fx-panel") becomes the handler's `target` parameter.
  broadcastEvent(["#c5-fx-panel"], "tour-ping")
]

// Event-driven action: runs whenever "tour-ping" is broadcast — NOT at a timeline
// time. Its parameter maps to the event's args by index (target ← eventArgs[0]).
on event "tour-ping" action ch5OnPing(target) [
  selectElement(target)
  addClass("in")
]

// Hub unwiring — the engine never detaches controllers on a timeline switch, so
// the hub's on leave removes every controller its on enter attached: one
// LabelController per localized line, one KeyboardController per `on key`
// (on #stage, the timeline's container) and one listener per card.
action hubUnwire() [
  with "#hub-title" { removeControllerFromElement("LabelController") }
  with "#hub-tagline" { removeControllerFromElement("LabelController") }
  with "#stage" {
    removeControllerFromElement("KeyboardController")
    removeControllerFromElement("KeyboardController")
    removeControllerFromElement("KeyboardController")
    removeControllerFromElement("KeyboardController")
    removeControllerFromElement("KeyboardController")
    removeControllerFromElement("KeyboardController")
  }
  with "#card-ch1" { removeControllerFromElement("DOMEventListenerController") }
  with "#card-ch2" { removeControllerFromElement("DOMEventListenerController") }
  with "#card-ch3" { removeControllerFromElement("DOMEventListenerController") }
  with "#card-ch4" { removeControllerFromElement("DOMEventListenerController") }
  with "#card-ch5" { removeControllerFromElement("DOMEventListenerController") }
  with "#card-ch6" { removeControllerFromElement("DOMEventListenerController") }
]

// ===========================================================================
// Hub — the landing menu. Click a card (or press its number) to jump into a
// chapter. The title and tagline are LabelControllers over locales.json.
// ===========================================================================
timeline "Hub" in "#stage" using raf {
  on enter [
    showView("#hub")
    selectElement("#hub-title")
    addController("LabelController", "hub.title")
    selectElement("#hub-tagline")
    addController("LabelController", "hub.tagline")
    on click "#card-ch1" navigate "Timeline & Time"
    on click "#card-ch2" navigate "Actions"
    on click "#card-ch3" navigate "Logic"
    on click "#card-ch4" navigate "Timeline Power Tools"
    on click "#card-ch5" navigate "Engine Reach"
    on click "#card-ch6" navigate "Tooling Magic"
    on key "1" navigate "Timeline & Time"
    on key "2" navigate "Actions"
    on key "3" navigate "Logic"
    on key "4" navigate "Timeline Power Tools"
    on key "6" navigate "Engine Reach"
    on key "7" navigate "Tooling Magic"
  ]
  on leave [
    hideView("#hub")
    hubUnwire()
  ]
}

// ===========================================================================
// Chapter 1 — Timeline & Time. Eight beats on the raf clock, written with the
// forms it teaches: a program-level time constant (@beat, @long), a chain of
// labelled `at` events (open.end, providers.end, …), a relative start (+0s),
// and one `target` beat with an end block.
// ===========================================================================
const beat = 6s // Chapter 1's basic beat (a time constant)
const long = @beat + 2s // 8s

timeline "Timeline & Time" in "#stage" using raf {

  // setup: show this chapter + narration + progress on enter; wire back, Esc,
  // space and r. On leave: hide, reset the view, unwire.
  on enter [
    enterChapter("#ch1")
    on click "#c1-to-hub" navigate "Hub"
    on key "Escape" navigate "Hub"
    on key "space" toggle
    on key "r" run replayChapter("#ch1")
  ]
  on leave [
    leaveChapter("#ch1", "#c1-to-hub")
  ]

  // Beat 1 — open on the canvas (0–6 s)
  at 0s for @beat as open [
    narrate("An Eligian presentation is one or more timelines. Here's the one you're watching.")
    revealBlock("#code-ch1")
    spotlight("#tok-timeline")
    callout("#cl-name", "its name — also what navigate and the engine's uri use")
    demo("#fx-stage")
  ]

  // Beat 2 — pick a driver (provider) and the header options (6–12 s)
  at open.end for @beat as providers [
    clearSpots()
    narrate("What advances the timeline? Its provider — and the header can loop it or fix its duration.")
    revealBlock("#c1-code-providers")
    spotlight("#tok-raf")
    callout("#cl-provider", "raf = animation clock · video / audio drive from media · scroll = the scroll position · custom")
    demo("#fx-providers")
  ]

  // Beat 3 — make something happen over a range (12–20 s)
  at providers.end for @long as ranges [
    clearSpots()
    narrate("Inside a timeline, at schedules work over a time range: start to end, or start for a duration.")
    revealBlock("#code-at")
    spotlight("#tok-at")
    callout("#cl-range", "a time range: start .. end — or start for duration")
    demo("#fx-hero")
  ]

  // Beat 4 — time speaks four units (20–27 s)
  at ranges.end for 7s as units [
    clearSpots()
    narrate("Times take units. No unit means seconds — and in arithmetic a bare number is a factor.")
    revealBlock("#code-units")
    callout("#cl-units", "42 = 42s · 500ms · 2s · 1.5m · 0.5h")
    demo("#fx-ruler")
  ]

  // Beat 5 — arithmetic and relative time (27–35 s)
  at units.end for @long as arith [
    clearSpots()
    narrate("Ranges can compute — and chain off the previous event with a +.")
    revealBlock("#code-arith")
    spotlight("#tok-plus")
    callout("#cl-relative", "relative time — anchored to the previous event's end")
    demo("#fx-chain")
  ]

  // Beat 6 — time constants and labels (35–43 s): this event starts relative
  // to beat 5's end, and every other beat is timed off @beat / @long and labels
  at +0s for @long as constants [
    clearSpots()
    narrate("Name a time once with const, label an event with as, and later times refer to them. This chapter is timed exactly that way.")
    revealBlock("#c1-code-labels")
    spotlight("#c1-tok-label")
    callout("#c1-cl-label", "@beat is a compile-time constant · open.end refers to an earlier event of this timeline")
    demo("#c1-fx-labels")
  ]

  // Beat 7 — target (43–50 s): REAL — the box lights at the start, and the end
  // block (also headed by the target's selectElement) unlights it
  at constants.end for 7s as targets target "#c1-target-box" [
    addClass("lit")
    clearSpots()
    narrate("target selects an element for a block's start and its end — and an inline end block is optional.")
    revealBlock("#c1-code-target")
    spotlight("#c1-tok-target")
    callout("#c1-cl-target", "selectElement at the head of both blocks; nothing carries from start to end")
    demo("#c1-fx-target")
  ] [
    removeClass("lit")
  ]

  // Beat 8 — recap: this timeline's own header and lifecycle blocks (50–58 s)
  at targets.end for @long as recap [
    clearSpots()
    narrate("That whole chapter? One timeline: on enter shows it, on leave cleans up, neither counts toward its 58 seconds, and its beats are timed with a constant and labels. Hub, space pauses, r replays.")
    revealBlock("#code-full")
    spotlight("#c1-tok-enter")
    callout("#c1-cl-lifecycle", "one open-ended action { start: 0 }, not counted in the duration · on leave runs on navigate / stop, not when the content ends")
    demo("#fx-endcard")
  ]
}

// ===========================================================================
// Chapter 2 — Actions & Composition. Eight beats, built entirely from the
// presentation library it describes: defining and calling actions, how
// parameters reach operations, endable actions, the dataflow contract the
// compiler infers, erased-parameter save / restore, and libraries.
// ===========================================================================
timeline "Actions" in "#stage" using raf {

  // setup: show this chapter + narration + progress on enter; wire back, Esc,
  // space and r. On leave: hide, reset the view, unwire.
  on enter [
    enterChapter("#ch2")
    on click "#c2-to-hub" navigate "Hub"
    on key "Escape" navigate "Hub"
    on key "space" toggle
    on key "r" run replayChapter("#ch2")
  ]
  on leave [
    leaveChapter("#ch2", "#c2-to-hub")
  ]

  sequence each [ clearSpots() ] {
    // Beat 1 — an action is a named list of operations (0–7 s)
    for 7s as b1 [
      narrate("An action is a named list of operations. Define once, call anywhere.")
      revealBlock("#c2-code-def")
      spotlight("#c2-tok-action")
      callout("#c2-cl-action", "declares a reusable action; its body runs top-to-bottom")
      demo("#c2-fx-chain")
    ]

    // Beat 2 — parameters and optional types (7–14 s)
    for 7s as b2 [
      narrate("Actions take parameters. Annotate types when you want the compiler's help — or leave the type off.")
      revealBlock("#c2-code-params")
      spotlight("#c2-tok-param")
      callout("#c2-cl-param", "optional type — string · number · boolean · object · array; no annotation = unchecked")
      demo("#c2-fx-fade")
    ]

    // Beat 3 — unified call syntax; a bare operation is not a timeline event (14–22 s)
    for 8s as b3 [
      narrate("Inside a block, calling your action looks exactly like calling a built-in operation.")
      revealBlock("#c2-code-call")
      spotlight("#c2-tok-call")
      callout("#c2-cl-call", "one syntax: action first, then built-in op; a bare operation is not a timeline event")
      demo("#c2-fx-call")
    ]

    // Beat 4 — parameters reach operations by name, or through setOperationData (22–30 s)
    for 8s as b4 [
      narrate("Parameters flow into operations by name — and when the names differ, the compiler bridges them.")
      revealBlock("#c2-code-byname")
      spotlight("#c2-tok-template")
      callout("#c2-cl-name", "same name → passed straight through · other name → a setOperationData before the operation")
      demo("#c2-fx-slot")
    ]

    // Beat 5 — endable actions: start and end are independent (30–38 s)
    for 8s as b5 [
      narrate("An endable action has two blocks: set up, then tear down — independently.")
      revealBlock("#c2-code-endable")
      spotlight("#c2-tok-endable")
      callout("#c2-cl-endable", "start & end run separately — re-select in each, or use target")
      demo("#c2-fx-toggle")
    ]

    // Beat 6 — dataflow contracts: what a block carries (38–46 s)
    for 8s as b6 [
      narrate("The compiler knows what each block carries. Call an action that needs a selected element where there is none, and it tells you.")
      revealBlock("#c2-code-contract")
      spotlight("#c2-tok-contract")
      callout("#c2-cl-contract", "an inferred contract — the hover says Requires from the caller")
      demo("#c2-fx-contract")
    ]

    // Beat 7 — erased parameters are saved and restored (46–54 s)
    for 8s as b7 [
      narrate("selectElement consumes its selector. Your parameter survives anyway: the compiler saves and restores it.")
      revealBlock("#c2-code-erased")
      spotlight("#c2-tok-erased")
      callout("#c2-cl-erased", "saved as __eligian_param_selector around the operation; found by eligian smoke · a parameter that reaches a selector is checked at every call (spec 056)")
      demo("#c2-fx-erased")
    ]

    // Beat 8 — libraries, imports and aliases (54–62 s)
    for 8s as b8 [
      narrate("Group actions into a library and import what you need — renamed if you like. Chapter 05 goes deeper. Hub.")
      revealBlock("#c2-code-lib")
      demo("#c2-fx-lib")
    ]
  }
}

// ===========================================================================
// Chapter 3 — Logic & Data. Eight beats: const folding, literals, operators,
// if / else if, for, break / continue, with, and the data sigils. Its real
// demos are the helper actions above: the badge (beat 4) runs a real
// if / else if / else, the bullet list (beat 5) and the number chips (beat 6)
// are revealed by real for loops, and beat 7's with is the prelude itself.
// ===========================================================================
timeline "Logic" in "#stage" using raf {

  // setup: show this chapter + narration + progress on enter; wire back, Esc,
  // space and r. On leave: hide, reset the view, unwire.
  on enter [
    enterChapter("#ch3")
    on click "#c3-to-hub" navigate "Hub"
    on key "Escape" navigate "Hub"
    on key "space" toggle
    on key "r" run replayChapter("#ch3")
  ]
  on leave [
    leaveChapter("#ch3", "#c3-to-hub")
  ]

  sequence each [ clearSpots() ] {
    // Beat 1 — const: folded when known, a scope variable when not (0–8 s)
    for 8s as b1 [
      narrate("const names a value. Known at compile time it is inlined wherever you write @name; a runtime value becomes a scope variable.")
      revealBlock("#c3-code-const")
      spotlight("#c3-tok-const")
      callout("#c3-cl-const", "@name reads a const · literal → folded in · runtime value → scope variable")
      demo("#c3-fx-scopes")
    ]

    // Beat 2 — literals (8–15 s)
    for 7s as b2 [
      narrate("Values are literals: strings in either quote, numbers, booleans, null, objects and arrays.")
      revealBlock("#c3-code-literals")
      spotlight("#c3-tok-literal")
      callout("#c3-cl-literal", "no negative literals: -2 is unary minus applied to 2")
      demo("#c3-fx-literals")
    ]

    // Beat 3 — operators fold at compile time (15–24 s)
    for 9s as b3 [
      narrate("Operators fold at compile time. On runtime values they belong in if conditions — except string +, which joins at runtime.")
      revealBlock("#c3-code-expr")
      spotlight("#c3-tok-expr")
      callout("#c3-cl-expr", "** · unary - ! · * / % · + - · < <= > >= · == != · && · ||")
      demo("#c3-fx-eval")
    ]

    // Beat 4 — if / else if / else: REAL, the badge goes active here, then
    // muted and plain in the two sub-steps after the sequence (24–33 s)
    for 9s as b4 [
      narrate("if / else if / else runs operations conditionally — when, otherwise, endWhen, nested.")
      revealBlock("#c3-code-if")
      spotlight("#c3-tok-if")
      callout("#c3-cl-if", "else if = else { if … }: a when nested in the otherwise")
      demo("#c3-fx-if")
      ch3Badge(2)
    ]

    // Beat 5 — for: REAL, a forEach reveals the bullet list ⭐ (33–42 s)
    for 9s as b5 [
      narrate("for iterates a collection — and this list is being revealed by one right now.")
      revealBlock("#c3-code-for")
      spotlight("#c3-tok-for")
      callout("#c3-cl-for", "@@p is the loop item (= @@currentItem); @@loopIndex / @@loopLength count")
      demo("#c3-fx-list")
      ch3RevealBullets()
    ]

    // Beat 6 — break / continue: REAL, 0 is skipped, 3 and 7 light, 12 stops it (42–50 s)
    for 8s as b6 [
      narrate("continue skips an item, break leaves the loop — only inside a for. Watch 0 skipped and the run stop at 12.")
      revealBlock("#c3-code-loopctl")
      spotlight("#c3-tok-break")
      callout("#c3-cl-loopctl", "continue → continueForEach · break → breakForEach · outside a for: compile error")
      demo("#c3-fx-loopctl")
      ch3LoopControl()
    ]

    // Beat 7 — with: REAL, the each prelude (clearSpots) is two with blocks (50–57 s)
    for 7s as b7 [
      narrate("with selects an element for a block, in any action or event — this tour's clearSpots is two with blocks.")
      revealBlock("#c3-code-with")
      spotlight("#c3-tok-with")
      callout("#c3-cl-with", "the selection stays after the block — there is nothing to restore")
      demo("#c3-fx-with")
    ]

    // Beat 8 — where data lives: the sigils and their short forms (57–64 s)
    for 7s as b8 [
      narrate("Where data lives: $operationdata, $globaldata, $scope — and the short forms you have been reading. Hub.")
      revealBlock("#c3-code-sigils")
      spotlight("#c3-tok-sigil")
      demo("#c3-fx-sigils")
    ]
  }

  // Beat 4's sub-steps: the same if, with 0 (else if → muted) and -1 (else → plain)
  at b4.start + 4s for 1s [ ch3Badge(0) ]
  at b4.start + 6s for 1s [ ch3Badge(-1) ]
}

// ===========================================================================
// Chapter 4 — Timeline Power Tools. `sequence` (auto consecutive timing) and
// `stagger` (one delayed event per item). Beat 4's card row is revealed by a
// REAL `stagger` block — the construct it teaches drives what you see.
// ===========================================================================
timeline "Timeline Power Tools" in "#stage" using raf {

  // setup: show this chapter + narration + progress on enter; wire back, Esc,
  // space and r. On leave: hide, reset the view, unwire.
  on enter [
    enterChapter("#ch4")
    on click "#c4-to-hub" navigate "Hub"
    on key "Escape" navigate "Hub"
    on key "space" toggle
    on key "r" run replayChapter("#ch4")
  ]
  on leave [
    leaveChapter("#ch4", "#c4-to-hub")
  ]

  sequence each [ clearSpots() ] {
    // Beat 1 — timing by hand is brittle
    for 7s [
      narrate("Scheduling a chain of events by hand means recomputing every time you tweak one.")
      revealBlock("#c4-code-manual")
      callout("#c4-cl-manual", "change one length and every later time is re-done by hand")
      demo("#c4-fx-ruler")
    ]

    // Beat 2 — sequence: auto consecutive timing
    for 8s [
      narrate("'sequence' lays events back-to-back automatically — each runs 'for' a duration.")
      revealBlock("#c4-code-sequence")
      spotlight("#c4-tok-seq")
      callout("#c4-cl-seq", "start = previous end → 0s..5s · 5s..15s · 15s..18s")
      demo("#c4-fx-seq")
    ]

    // Beat 3 — edit one, the rest follow (labeled: the stagger after this
    // sequence starts at its end)
    for 7s as editBeat [
      narrate("Because starts are computed, changing one duration shifts everything after it.")
      callout("#c4-cl-edit", "shorten 'main' and 'outro' slides left — no re-numbering")
      demo("#c4-fx-seq")
    ]

    // Beat 4 ⭐ — stagger; the card row itself is revealed by the REAL stagger below
    for 9s [
      narrate("'stagger' fans one effect across a collection — each item starts a little after the last.")
      revealBlock("#c4-code-stagger")
      spotlight("#c4-tok-stagger")
      callout("#c4-cl-stagger", "200ms delay between starts · the item feeds the action's first arg")
      demo("#c4-fx-row")
    ]

    // Beat 5 — delay vs duration + the inline form
    for 8s [
      narrate("delay is the gap between starts; duration is how long each lasts — they overlap on purpose.")
      revealBlock("#c4-code-inline")
      callout("#c4-cl-inline", "inline start/end op blocks instead of 'with <action>'")
      demo("#c4-fx-cascade")
    ]

    // Beat 6 — which tool? recap + the reveal
    for 8s [
      narrate("'sequence' for distinct back-to-back steps; 'stagger' for one effect across many items.")
      revealBlock("#c4-code-recap")
      spotlight("#c4-tok-recap")
      demo("#c4-fx-done")
    ]
  }

  // Beat 4 ⭐ — a REAL stagger reveals the card row (fires at 22s, with the beat).
  // Anchored at Beat 3's end ('at editBeat.end' = 22s), so it can sit after the
  // sequence; cards reveal 22s..23.9s.
  stagger 200ms ["#c4-card-1", "#c4-card-2", "#c4-card-3"] at editBeat.end with revealCard() for 1.5s
}

// ===========================================================================
// Chapter 5 — Engine Reach. Reaching past the timeline clock into the engine's
// runtime services: the eventbus (broadcastEvent), event-driven `on event`
// actions, and controllers. Beat 3+4 wire a REAL eventbus round-trip — clicking
// the button reveals the panel through controller → broadcast → on event. Beat 5
// (i18n / LabelController) is illustrative (no locale assets authored for the tour).
// ===========================================================================
timeline "Engine Reach" in "#stage" using raf {

  // setup: show this chapter + narration + progress on enter; wire back, Esc,
  // space and r. On leave: hide, reset the view, unwire.
  on enter [
    enterChapter("#ch5")
    on click "#c5-to-hub" navigate "Hub"
    on key "Escape" navigate "Hub"
    on key "space" toggle
    on key "r" run replayChapter("#ch5")
  ]
  on leave [
    leaveChapter("#ch5", "#c5-to-hub")
  ]

  sequence each [ clearSpots() ] {
    // Beat 1 — beyond the clock
    for 7s [
      narrate("Everything so far fired on the timeline clock. But a presentation also has to react — that's engine reach.")
      revealBlock("#c5-code-overview")
      callout("#c5-cl-over", "three doors past the clock: the eventbus, on event, controllers")
      demo("#c5-fx-doors")
    ]

    // Beat 2 — the eventbus: broadcast vs request
    for 8s [
      narrate("broadcastEvent puts a message on the engine's bus. Broadcast reaches every listener; request asks for the one that answers.")
      revealBlock("#c5-code-eventbus")
      spotlight("#c5-tok-bcast")
      callout("#c5-cl-bus", "request-timeline-uri is the request the navigate sugar emits")
      demo("#c5-fx-bus")
    ]

    // Beat 3 ⭐ — on event (real round-trip, half 1: the handler that answers)
    for 9s [
      narrate("An on event action runs when its event fires, not at a time. Click the button — it broadcasts, and this handler answers.")
      revealBlock("#c5-code-onevent")
      spotlight("#c5-tok-onevent")
      callout("#c5-cl-on", "params map to the event's args by position: target is eventArgs[0]")
      demo("#c5-fx-bus")
    ]

    // Beat 4 — controllers (real round-trip, half 2: wires the live button)
    for 8s [
      narrate("A controller attaches lasting behaviour to an element. The button's click is wired by a DOMEventListenerController — one of eight.")
      revealBlock("#c5-code-controller")
      spotlight("#c5-tok-ctrl")
      callout("#c5-cl-ctrl", "selectElement + addController; this is what navigate desugars to")
      demo("#c5-fx-bus")
      ch5WireButton()
    ]

    // Beat 5 — i18n / locales (illustrative: no locale assets authored for the tour)
    for 8s [
      narrate("Locales make text translatable. A LabelController binds a translation key to an element and re-renders on language-change.")
      revealBlock("#c5-code-label")
      spotlight("#c5-tok-loc")
      callout("#c5-cl-loc", "translationKey resolved via the rosetta locale system")
      demo("#c5-fx-label")
    ]

    // Beat 6 — the chrome was the lesson: recap + the reveal
    for 8s [
      narrate("Eventbus, on event, controllers, locales — the navigation and narration you've used were built from exactly these. Click ← Hub for more.")
      revealBlock("#c5-code-recap")
      spotlight("#c5-tok-recap")
      demo("#c5-fx-done")
    ]
  }
}

// ===========================================================================
// Chapter 6 — Tooling Magic. The dev-time half of Eligian: compile + live
// preview, CSS validation, autocomplete, JSDoc hover, semantic validation,
// CSS hot-reload, locale editor. UNLIKE Chapters 1–5 this teaches VS Code/LSP
// tooling, which a running timeline can't exercise — so the effect pane REENACTS
// the editor (mock panels with strings copied verbatim from the real providers).
// No new actions, no runtime self-demo: the genuine dogfood is historical (this
// whole tour was authored, validated, autocompleted and compiled by these tools).
// See storyboards/chapter-06-tooling-magic.md §3.
// ===========================================================================
timeline "Tooling Magic" in "#stage" using raf {

  // setup: show this chapter + narration + progress on enter; wire back, Esc,
  // space and r. On leave: hide, reset the view, unwire.
  on enter [
    enterChapter("#ch6")
    on click "#c6-to-hub" navigate "Hub"
    on key "Escape" navigate "Hub"
    on key "space" toggle
    on key "r" run replayChapter("#ch6")
  ]
  on leave [
    leaveChapter("#ch6", "#c6-to-hub")
  ]

  sequence each [ clearSpots() ] {
    // Beat 1 — the editor is half the language
    for 7s [
      narrate("Eligian isn't just shorter Eligius JSON — it's a typed, tooled way to write it. Everything you've watched was authored with these tools.")
      revealBlock("#c6-code-why")
      callout("#c6-cl-why", "concise on the left, type-safe everywhere, live in the preview")
      demo("#c6-fx-editor")
    ]

    // Beat 2 — compile + live preview
    for 8s [
      narrate("Preview Timeline compiles your .eligian on the fly, runs it in an embedded engine, and reloads on every save. This tour is what you'd see there.")
      revealBlock("#c6-code-preview")
      spotlight("#c6-tok-preview")
      callout("#c6-cl-preview", "compiles + runs in a webview engine; a FileWatcher reloads on save")
      demo("#c6-fx-preview")
    ]

    // Beat 3 ⭐ — CSS validation + quick-fix (the tour's own safety net)
    for 9s [
      narrate("Every class and selector is checked against your imported CSS. Typo one and you get a squiggle, a suggestion, and a one-click fix.")
      revealBlock("#c6-code-css")
      spotlight("#c6-tok-css")
      callout("#c6-cl-css", "CSS class 'buton' is not defined. Did you mean: button?")
      demo("#c6-fx-squiggle")
    ]

    // Beat 4 — autocomplete everywhere
    for 8s [
      narrate("Type and the editor knows what fits: operations with their parameters, the eight controllers, label IDs, CSS classes, even an on event skeleton.")
      revealBlock("#c6-code-complete")
      spotlight("#c6-tok-complete")
      callout("#c6-cl-complete", "operations show their signature and docs; controllers list their params")
      demo("#c6-fx-complete")
    ]

    // Beat 5 — JSDoc hover + semantic validation
    for 8s [
      narrate("Document an action with @param and the editor hovers those docs at every call — and flags wrong argument counts, unknown ops, bad nav or event names.")
      revealBlock("#c6-code-jsdoc")
      spotlight("#c6-tok-jsdoc")
      callout("#c6-cl-jsdoc", "@param docs on hover; semantic checks catch the rest")
      demo("#c6-fx-hover")
    ]

    // Beat 6 — hot-reload, locales, the whole picture + end card
    for 8s [
      narrate("Tweak your CSS and it hot-reloads into the running preview. Edit translations in a dedicated editor. Concise, type-safe, live — that's Eligian. Click ← Hub.")
      revealBlock("#c6-code-recap")
      spotlight("#c6-tok-recap")
      demo("#c6-fx-done")
    ]
  }
}
