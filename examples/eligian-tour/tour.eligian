/**
 * Eligian Tour — single-file entry (hub + chapters).
 *
 * The whole presentation compiles to ONE Eligius config: a hub menu plus every
 * chapter, each as its own `timeline`. The engine renders the shared layout once
 * and switches between timelines when a card (or the back button) is clicked —
 * that click→switch is the `navigate` sugar, which compiles to a
 * DOMEventListenerController that broadcasts `request-timeline-uri`.
 *
 * VIEW MANAGEMENT — each timeline shows ONLY its own view, through its
 * lifecycle blocks:
 *   on enter → enterChapter(self) (show + progress bar) + wire nav and keys
 *   on leave → leaveChapter(self, back) (hide, reset the view, unwire)
 * replay (r) → replayChapter(self): reset the view, then seek to 0.
 * The engine's switch lifecycle runs the leaving timeline's `on leave`, then the
 * entering timeline's `on enter`, so no timeline needs to hide the others. They
 * are not events: the view stays up after the last beat, and the timeline's
 * duration is its last beat's end. (See ELIGIUS_EXECUTION_MODEL.md §7b.)
 * `#narration` is a shared subtitle bar each chapter shows/hides alongside its
 * own view. Keyboard: 1–8 on the hub, Esc back, space pauses, r replays.
 *
 * Snippets in the code pane are hand-authored display assets (pre-tokenized in
 * layout.html); this file is the real machinery driving them.
 */
languages {
  * "en-US" "English"
    "nl-NL" "Nederlands"
}

layout "./layout.html"
styles "./tour.css"
locales "./locales.json"

import { revealBlock, spotlight, clearSpots, callout, narrate, demo, revealCard, showView, hideView, enterChapter, replayChapter, leaveChapter } from "./presentation.eligian"

// Chapter 05's own subjects: a named asset import (placed by cfPlaceHint in
// beat 4) and the host module (declared here; Engine Reach calls stampTime).
import hint from "./hint.html"
extensions "./host.js" {
  operation stampTime(selector: string)
  function shout
}

// Chapter-3 helpers: the executed code mirrors the taught snippets.
// House rule: const lives in actions (or at program level), not in timeline
// blocks, so the loop and the conditional live here.
action ch3Badge(count) [
  // count is a runtime parameter, so this emits a real when / otherwise / endWhen
  selectElement("#c3-badge")
  if (count > 0) {
    removeClass("muted")
    addClass("active")
  } else if (count == 0) {
    removeClass("active")
    addClass("muted")
  } else {
    removeClass("active")
    removeClass("muted")
  }
]

action ch3RevealBullets() [
  const points = ["#c3-b1", "#c3-b2", "#c3-b3"]   // folded into forEach's collection
  for (p in @points) {
    selectElement(@@p)                           // the loop item (= @@currentItem)
    addClass("in")
  }
]

action ch3LoopControl() [
  const numbers = [0, 3, 7, 12]
  for (n in @numbers) {
    if (@@n == 0) { continue }                   // continueForEach
    if (@@n > 9) { break }                       // breakForEach
    with "#c3-n-" + @@n { addClass("lit") }      // runtime concat: "#c3-n-3", "#c3-n-7"
  }
]

// Chapter-05 helper: writes the named HTML import into its panel; @hint is
// the content of hint.html, inlined at compile time.
action cfPlaceHint() [
  selectElement("#cf-fx-hint")
  setElementContent(@hint)
]

// Engine Reach helpers — a REAL eventbus round-trip, wired live by the chapter's
// on enter (`on click "#c5-fx-ping" run ch5BroadcastPing()`): the click runs
// ch5BroadcastPing, which broadcasts "tour-ping"; the `on event` handler below
// catches it and reveals the panel. Interactions, the eventbus and event-driven
// actions at once, plus a host operation (stampTime, host.js) and the live
// language switch the LabelController follows.
action ch5BroadcastPing() [
  // broadcastEvent's params are (eventArgs, eventName) in that order — the array
  // first. eventArgs[0] ("#c5-fx-panel") becomes the handler's `target` parameter.
  broadcastEvent(["#c5-fx-panel"], "tour-ping")
]

// Event-driven action: runs whenever "tour-ping" is broadcast — NOT at a timeline
// time. Its parameter maps to the event's args by index (target ← eventArgs[0]).
on event "tour-ping" action ch5OnPing(target) [
  selectElement(target)
  addClass("in")
]

// A host operation (declared in the extensions block, exported by host.js),
// called like a built-in: writes the current time into the chip.
action ch5Stamp() [
  stampTime("#c5-fx-clock")
]

// The language buttons: the engine listens for language-change and sets the
// locale; every LabelController re-renders.
action ch5Dutch() [
  broadcastEvent(["nl-NL"], "language-change")
]

action ch5English() [
  broadcastEvent(["en-US"], "language-change")
]

// Hub unwiring — the engine never detaches controllers on a timeline switch, so
// the hub's on leave removes every controller its on enter attached: one
// LabelController per localized line, one KeyboardController per `on key`
// (on #stage, the timeline's container) and one listener per card.
action hubUnwire() [
  with "#hub-title" { removeControllerFromElement("LabelController") }
  with "#hub-tagline" { removeControllerFromElement("LabelController") }
  with "#stage" {
    removeControllerFromElement("KeyboardController")
    removeControllerFromElement("KeyboardController")
    removeControllerFromElement("KeyboardController")
    removeControllerFromElement("KeyboardController")
    removeControllerFromElement("KeyboardController")
    removeControllerFromElement("KeyboardController")
    removeControllerFromElement("KeyboardController")
    removeControllerFromElement("KeyboardController")
  }
  with "#card-ch1" { removeControllerFromElement("DOMEventListenerController") }
  with "#card-ch2" { removeControllerFromElement("DOMEventListenerController") }
  with "#card-ch3" { removeControllerFromElement("DOMEventListenerController") }
  with "#card-ch4" { removeControllerFromElement("DOMEventListenerController") }
  with "#card-chf" { removeControllerFromElement("DOMEventListenerController") }
  with "#card-ch5" { removeControllerFromElement("DOMEventListenerController") }
  with "#card-ch6" { removeControllerFromElement("DOMEventListenerController") }
  with "#card-chc" { removeControllerFromElement("DOMEventListenerController") }
]

// ===========================================================================
// Hub — the landing menu. Click a card (or press its number) to jump into a
// chapter. The title and tagline are LabelControllers over locales.json.
// ===========================================================================
timeline "Hub" in "#stage" using raf {
  on enter [
    showView("#hub")
    selectElement("#hub-title")
    addController("LabelController", "hub.title")
    selectElement("#hub-tagline")
    addController("LabelController", "hub.tagline")
    on click "#card-ch1" navigate "Timeline & Time"
    on click "#card-ch2" navigate "Actions"
    on click "#card-ch3" navigate "Logic"
    on click "#card-ch4" navigate "Timeline Power Tools"
    on click "#card-chf" navigate "Files & Imports"
    on click "#card-ch5" navigate "Engine Reach"
    on click "#card-ch6" navigate "The Editor"
    on click "#card-chc" navigate "The Command Line"
    on key "1" navigate "Timeline & Time"
    on key "2" navigate "Actions"
    on key "3" navigate "Logic"
    on key "4" navigate "Timeline Power Tools"
    on key "5" navigate "Files & Imports"
    on key "6" navigate "Engine Reach"
    on key "7" navigate "The Editor"
    on key "8" navigate "The Command Line"
  ]
  on leave [
    hideView("#hub")
    hubUnwire()
  ]
}

// ===========================================================================
// Chapter 1 — Timeline & Time. Eight beats on the raf clock, written with the
// forms it teaches: a program-level time constant (@beat, @long), a chain of
// labelled `at` events (open.end, providers.end, …), a relative start (+0s),
// and one `target` beat with an end block.
// ===========================================================================
const beat = 6s // Chapter 1's basic beat (a time constant)
const long = @beat + 2s // 8s

timeline "Timeline & Time" in "#stage" using raf {

  // setup: show this chapter + narration + progress on enter; wire back, Esc,
  // space and r. On leave: hide, reset the view, unwire.
  on enter [
    enterChapter("#ch1")
    on click "#c1-to-hub" navigate "Hub"
    on key "Escape" navigate "Hub"
    on key "space" toggle
    on key "r" run replayChapter("#ch1")
  ]
  on leave [
    leaveChapter("#ch1", "#c1-to-hub")
  ]

  // Beat 1 — open on the canvas (0–6 s)
  at 0s for @beat as open [
    narrate("An Eligian presentation is one or more timelines. Here's the one you're watching.")
    revealBlock("#code-ch1")
    spotlight("#tok-timeline")
    callout("#cl-name", "its name — also what navigate and the engine's uri use")
    demo("#fx-stage")
  ]

  // Beat 2 — pick a driver (provider) and the header options (6–12 s)
  at open.end for @beat as providers [
    clearSpots()
    narrate("What advances the timeline? Its provider — and the header can loop it or fix its duration.")
    revealBlock("#c1-code-providers")
    spotlight("#tok-raf")
    callout("#cl-provider", "raf = animation clock · video / audio drive from media · scroll = the scroll position · custom")
    demo("#fx-providers")
  ]

  // Beat 3 — make something happen over a range (12–20 s)
  at providers.end for @long as ranges [
    clearSpots()
    narrate("Inside a timeline, at schedules work over a time range: start to end, or start for a duration.")
    revealBlock("#code-at")
    spotlight("#tok-at")
    callout("#cl-range", "a time range: start .. end — or start for duration")
    demo("#fx-hero")
  ]

  // Beat 4 — time speaks four units (20–27 s)
  at ranges.end for 7s as units [
    clearSpots()
    narrate("Times take units. No unit means seconds — and in arithmetic a bare number is a factor.")
    revealBlock("#code-units")
    callout("#cl-units", "42 = 42s · 500ms · 2s · 1.5m · 0.5h")
    demo("#fx-ruler")
  ]

  // Beat 5 — arithmetic and relative time (27–35 s)
  at units.end for @long as arith [
    clearSpots()
    narrate("Ranges can compute — and chain off the previous event with a +.")
    revealBlock("#code-arith")
    spotlight("#tok-plus")
    callout("#cl-relative", "relative time — anchored to the previous event's end")
    demo("#fx-chain")
  ]

  // Beat 6 — time constants and labels (35–43 s): this event starts relative
  // to beat 5's end, and every other beat is timed off @beat / @long and labels
  at +0s for @long as constants [
    clearSpots()
    narrate("Name a time once with const, label an event with as, and later times refer to them. This chapter is timed exactly that way.")
    revealBlock("#c1-code-labels")
    spotlight("#c1-tok-label")
    callout("#c1-cl-label", "@beat is a compile-time constant · open.end refers to an earlier event of this timeline")
    demo("#c1-fx-labels")
  ]

  // Beat 7 — target (43–50 s): REAL — the box lights at the start, and the end
  // block (also headed by the target's selectElement) unlights it
  at constants.end for 7s as targets target "#c1-target-box" [
    addClass("lit")
    clearSpots()
    narrate("target selects an element for a block's start and its end — and an inline end block is optional.")
    revealBlock("#c1-code-target")
    spotlight("#c1-tok-target")
    callout("#c1-cl-target", "selectElement at the head of both blocks; nothing carries from start to end")
    demo("#c1-fx-target")
  ] [
    removeClass("lit")
  ]

  // Beat 8 — recap: this timeline's own header and lifecycle blocks (50–58 s)
  at targets.end for @long as recap [
    clearSpots()
    narrate("That whole chapter? One timeline: on enter shows it, on leave cleans up, neither counts toward its 58 seconds, and its beats are timed with a constant and labels. Hub, space pauses, r replays.")
    revealBlock("#code-full")
    spotlight("#c1-tok-enter")
    callout("#c1-cl-lifecycle", "one open-ended action { start: 0 }, not counted in the duration · on leave runs on navigate / stop, not when the content ends")
    demo("#fx-endcard")
  ]
}

// ===========================================================================
// Chapter 2 — Actions & Composition. Eight beats, built entirely from the
// presentation library it describes: defining and calling actions, how
// parameters reach operations, endable actions, the dataflow contract the
// compiler infers, erased-parameter save / restore, and libraries.
// ===========================================================================
timeline "Actions" in "#stage" using raf {

  // setup: show this chapter + narration + progress on enter; wire back, Esc,
  // space and r. On leave: hide, reset the view, unwire.
  on enter [
    enterChapter("#ch2")
    on click "#c2-to-hub" navigate "Hub"
    on key "Escape" navigate "Hub"
    on key "space" toggle
    on key "r" run replayChapter("#ch2")
  ]
  on leave [
    leaveChapter("#ch2", "#c2-to-hub")
  ]

  sequence each [ clearSpots() ] {
    // Beat 1 — an action is a named list of operations (0–7 s)
    for 7s as b1 [
      narrate("An action is a named list of operations. Define once, call anywhere.")
      revealBlock("#c2-code-def")
      spotlight("#c2-tok-action")
      callout("#c2-cl-action", "declares a reusable action; its body runs top-to-bottom")
      demo("#c2-fx-chain")
    ]

    // Beat 2 — parameters and optional types (7–14 s)
    for 7s as b2 [
      narrate("Actions take parameters. Annotate types when you want the compiler's help — or leave the type off.")
      revealBlock("#c2-code-params")
      spotlight("#c2-tok-param")
      callout("#c2-cl-param", "optional type — string · number · boolean · object · array; no annotation = unchecked")
      demo("#c2-fx-fade")
    ]

    // Beat 3 — unified call syntax; a bare operation is not a timeline event (14–22 s)
    for 8s as b3 [
      narrate("Inside a block, calling your action looks exactly like calling a built-in operation.")
      revealBlock("#c2-code-call")
      spotlight("#c2-tok-call")
      callout("#c2-cl-call", "one syntax: action first, then built-in op; a bare operation is not a timeline event")
      demo("#c2-fx-call")
    ]

    // Beat 4 — parameters reach operations by name, or through setOperationData (22–30 s)
    for 8s as b4 [
      narrate("Parameters flow into operations by name — and when the names differ, the compiler bridges them.")
      revealBlock("#c2-code-byname")
      spotlight("#c2-tok-template")
      callout("#c2-cl-name", "same name → passed straight through · other name → a setOperationData before the operation")
      demo("#c2-fx-slot")
    ]

    // Beat 5 — endable actions: start and end are independent (30–38 s)
    for 8s as b5 [
      narrate("An endable action has two blocks: set up, then tear down — independently.")
      revealBlock("#c2-code-endable")
      spotlight("#c2-tok-endable")
      callout("#c2-cl-endable", "start & end run separately — re-select in each, or use target")
      demo("#c2-fx-toggle")
    ]

    // Beat 6 — dataflow contracts: what a block carries (38–46 s)
    for 8s as b6 [
      narrate("The compiler knows what each block carries. Call an action that needs a selected element where there is none, and it tells you.")
      revealBlock("#c2-code-contract")
      spotlight("#c2-tok-contract")
      callout("#c2-cl-contract", "an inferred contract — the hover says Requires from the caller")
      demo("#c2-fx-contract")
    ]

    // Beat 7 — erased parameters are saved and restored (46–54 s)
    for 8s as b7 [
      narrate("selectElement consumes its selector. Your parameter survives anyway: the compiler saves and restores it.")
      revealBlock("#c2-code-erased")
      spotlight("#c2-tok-erased")
      callout("#c2-cl-erased", "saved as __eligian_param_selector around the operation; found by eligian smoke · a parameter that reaches a selector is checked at every call (spec 056)")
      demo("#c2-fx-erased")
    ]

    // Beat 8 — libraries, imports and aliases (54–62 s)
    for 8s as b8 [
      narrate("Group actions into a library and import what you need — renamed if you like. Chapter 05 goes deeper. Hub.")
      revealBlock("#c2-code-lib")
      demo("#c2-fx-lib")
    ]
  }
}

// ===========================================================================
// Chapter 3 — Logic & Data. Eight beats: const folding, literals, operators,
// if / else if, for, break / continue, with, and the data sigils. Its real
// demos are the helper actions above: the badge (beat 4) runs a real
// if / else if / else, the bullet list (beat 5) and the number chips (beat 6)
// are revealed by real for loops, and beat 7's with is the prelude itself.
// ===========================================================================
timeline "Logic" in "#stage" using raf {

  // setup: show this chapter + narration + progress on enter; wire back, Esc,
  // space and r. On leave: hide, reset the view, unwire.
  on enter [
    enterChapter("#ch3")
    on click "#c3-to-hub" navigate "Hub"
    on key "Escape" navigate "Hub"
    on key "space" toggle
    on key "r" run replayChapter("#ch3")
  ]
  on leave [
    leaveChapter("#ch3", "#c3-to-hub")
  ]

  sequence each [ clearSpots() ] {
    // Beat 1 — const: folded when known, a scope variable when not (0–8 s)
    for 8s as b1 [
      narrate("const names a value. Known at compile time it is inlined wherever you write @name; a runtime value becomes a scope variable.")
      revealBlock("#c3-code-const")
      spotlight("#c3-tok-const")
      callout("#c3-cl-const", "@name reads a const · literal → folded in · runtime value → scope variable")
      demo("#c3-fx-scopes")
    ]

    // Beat 2 — literals (8–15 s)
    for 7s as b2 [
      narrate("Values are literals: strings in either quote, numbers, booleans, null, objects and arrays.")
      revealBlock("#c3-code-literals")
      spotlight("#c3-tok-literal")
      callout("#c3-cl-literal", "no negative literals: -2 is unary minus applied to 2")
      demo("#c3-fx-literals")
    ]

    // Beat 3 — operators fold at compile time (15–24 s)
    for 9s as b3 [
      narrate("Operators fold at compile time. On runtime values they belong in if conditions — except string +, which joins at runtime.")
      revealBlock("#c3-code-expr")
      spotlight("#c3-tok-expr")
      callout("#c3-cl-expr", "** · unary - ! · * / % · + - · < <= > >= · == != · && · ||")
      demo("#c3-fx-eval")
    ]

    // Beat 4 — if / else if / else: REAL, the badge goes active here, then
    // muted and plain in the two sub-steps after the sequence (24–33 s)
    for 9s as b4 [
      narrate("if / else if / else runs operations conditionally — when, otherwise, endWhen, nested.")
      revealBlock("#c3-code-if")
      spotlight("#c3-tok-if")
      callout("#c3-cl-if", "else if = else { if … }: a when nested in the otherwise")
      demo("#c3-fx-if")
      ch3Badge(2)
    ]

    // Beat 5 — for: REAL, a forEach reveals the bullet list ⭐ (33–42 s)
    for 9s as b5 [
      narrate("for iterates a collection — and this list is being revealed by one right now.")
      revealBlock("#c3-code-for")
      spotlight("#c3-tok-for")
      callout("#c3-cl-for", "@@p is the loop item (= @@currentItem); @@loopIndex / @@loopLength count")
      demo("#c3-fx-list")
      ch3RevealBullets()
    ]

    // Beat 6 — break / continue: REAL, 0 is skipped, 3 and 7 light, 12 stops it (42–50 s)
    for 8s as b6 [
      narrate("continue skips an item, break leaves the loop — only inside a for. Watch 0 skipped and the run stop at 12.")
      revealBlock("#c3-code-loopctl")
      spotlight("#c3-tok-break")
      callout("#c3-cl-loopctl", "continue → continueForEach · break → breakForEach · outside a for: compile error")
      demo("#c3-fx-loopctl")
      ch3LoopControl()
    ]

    // Beat 7 — with: REAL, the each prelude (clearSpots) is two with blocks (50–57 s)
    for 7s as b7 [
      narrate("with selects an element for a block, in any action or event — this tour's clearSpots is two with blocks.")
      revealBlock("#c3-code-with")
      spotlight("#c3-tok-with")
      callout("#c3-cl-with", "the selection stays after the block — there is nothing to restore")
      demo("#c3-fx-with")
    ]

    // Beat 8 — where data lives: the sigils and their short forms (57–64 s)
    for 7s as b8 [
      narrate("Where data lives: $operationdata, $globaldata, $scope — and the short forms you have been reading. Hub.")
      revealBlock("#c3-code-sigils")
      spotlight("#c3-tok-sigil")
      demo("#c3-fx-sigils")
    ]
  }

  // Beat 4's sub-steps: the same if, with 0 (else if → muted) and -1 (else → plain)
  at b4.start + 4s for 1s [ ch3Badge(0) ]
  at b4.start + 6s for 1s [ ch3Badge(-1) ]
}

// ===========================================================================
// Chapter 4 — Timeline Power Tools. Seven beats: timing by hand, `sequence`,
// editing one duration, `stagger`, sequence items (inline blocks, labels,
// each / then), the inline stagger anchored with `at`, and a recap. The chapter
// is written with what it teaches: its beats are one sequence whose then flips
// #c4-pulse at every beat boundary, and two REAL staggers after it reveal the
// card row (beat 4) and light the wave chips (beat 6).
// ===========================================================================
timeline "Timeline Power Tools" in "#stage" using raf {

  // setup: show this chapter + narration + progress on enter; wire back, Esc,
  // space and r. On leave: hide, reset the view, unwire.
  on enter [
    enterChapter("#ch4")
    on click "#c4-to-hub" navigate "Hub"
    on key "Escape" navigate "Hub"
    on key "space" toggle
    on key "r" run replayChapter("#ch4")
  ]
  on leave [
    leaveChapter("#ch4", "#c4-to-hub")
  ]

  // each runs before every item's start operations; then after every item's
  // end operations, in the same instant as the next item's each, so a lit /
  // unlit pair would cancel out: then toggles the chrome dot instead.
  sequence each [ clearSpots() ] then [ with "#c4-pulse" { toggleClass("lit") } ] {
    // Beat 1 — timing by hand is brittle (0–7 s)
    for 7s as b1 [
      narrate("Scheduling a chain of events by hand means recomputing every time you tweak one.")
      revealBlock("#c4-code-manual")
      callout("#c4-cl-manual", "change one length and every later time is re-done by hand")
      demo("#c4-fx-ruler")
    ]

    // Beat 2 — sequence: auto consecutive timing (7–15 s)
    for 8s as b2 [
      narrate("'sequence' lays events back-to-back automatically — each runs 'for' a duration.")
      revealBlock("#c4-code-sequence")
      spotlight("#c4-tok-seq")
      callout("#c4-cl-seq", "start = previous end → 0s..5s · 5s..15s · 15s..18s")
      demo("#c4-fx-seq")
    ]

    // Beat 3 — edit one, the rest follow (15–22 s); labelled: the first
    // stagger after this sequence starts at its end
    for 7s as editBeat [
      narrate("Because starts are computed, changing one duration shifts everything after it.")
      callout("#c4-cl-edit", "shorten 'main' and 'outro' slides left — no re-numbering")
      demo("#c4-fx-seq")
    ]

    // Beat 4 ⭐ — stagger; the card row is revealed by REAL stagger 1 below (22–31 s)
    for 9s as b4 [
      narrate("'stagger' fans one effect across a collection — each item starts a little after the last.")
      revealBlock("#c4-code-stagger")
      spotlight("#c4-tok-stagger")
      callout("#c4-cl-stagger", "200ms between starts · the item is the action's first argument · at editBeat.end anchors the first item")
      demo("#c4-fx-row")
    ]

    // Beat 5 — sequence items: inline blocks, labels, each / then; REAL: this
    // sequence's own each and then (31–40 s)
    for 9s as b5 [
      narrate("A sequence item can be an inline block, labelled with as; each runs before every item, then after it. each clears the spotlights; then flips this dot at the end of every beat.")
      revealBlock("#c4-code-items")
      spotlight("#c4-tok-each")
      callout("#c4-cl-items", "each → before every item's start ops · then → after every item's end ops, in the same instant as the next each · editBeat.end usable later")
      demo("#c4-fx-items")
    ]

    // Beat 6 ⭐ — the inline stagger, anchored on this beat; the wave chips are
    // lit by REAL stagger 2 below (40–49 s)
    for 9s as waveBeat [
      narrate("The inline stagger form has its own start and end blocks, and at anchors the first item on a time instead of the previous event. Watch the wave.")
      revealBlock("#c4-code-inline")
      spotlight("#c4-tok-anchor")
      callout("#c4-cl-inline", "every block starts empty: selectElement(@@item) first · at +2s would count from the previous event")
      demo("#c4-fx-cascade")
    ]

    // Beat 7 — which tool? recap + the end card (49–57 s)
    for 8s as b7 [
      narrate("sequence for distinct back-to-back steps; stagger for one effect across many items. Hub.")
      revealBlock("#c4-code-recap")
      spotlight("#c4-tok-recap")
      demo("#c4-fx-done")
    ]
  }

  // REAL stagger 1 (beat 4): the cards reveal from editBeat.end = 22 s, 200ms
  // apart (22 s, 22.2 s, 22.4 s), 1.5 s each
  stagger 200ms ["#c4-card-1", "#c4-card-2", "#c4-card-3"] at editBeat.end with revealCard() for 1.5s

  // REAL stagger 2 (beat 6): the inline form with an end block, anchored on the
  // beat; every block starts empty, so each selects its item first. The chips
  // light at 41 s, 41.15 s, 41.3 s and go out 2 s later.
  stagger 150ms ["#c4-wave-1", "#c4-wave-2", "#c4-wave-3"] at waveBeat.start + 1s for 2s [
    selectElement(@@item)
    addClass("lit")
  ] [
    selectElement(@@item)
    removeClass("lit")
  ]
}

// ===========================================================================
// Chapter 05 — Files & Imports. Eight beats: program vs library, the languages
// block, default imports, named asset imports, library imports and private
// actions, the extensions import, comments and JSDoc, keywords. Its real code
// is this file's own head: the languages block, the default imports, the
// library import, `import hint` (placed by cfPlaceHint in beat 4) and the
// extensions declaration.
// ===========================================================================
timeline "Files & Imports" in "#stage" using raf {

  // setup: show this chapter + narration + progress on enter; wire back, Esc,
  // space and r. On leave: hide, reset the view, unwire.
  on enter [
    enterChapter("#chf")
    on click "#cf-to-hub" navigate "Hub"
    on key "Escape" navigate "Hub"
    on key "space" toggle
    on key "r" run replayChapter("#chf")
  ]
  on leave [
    leaveChapter("#chf", "#cf-to-hub")
  ]

  sequence each [ clearSpots() ] {
    // Beat 1 — two kinds of file: a program and a library (0–7 s)
    for 7s as b1 [
      narrate("An .eligian file is a program — timelines, actions, imports — or a library that starts with library and holds only actions.")
      revealBlock("#cf-code-files")
      spotlight("#cf-tok-library")
      callout("#cf-cl-files", "a library may import other libraries; no timelines, consts or assets; it cannot be compiled on its own")
      demo("#cf-fx-files")
    ]

    // Beat 2 — languages: this file's own block (7–14 s)
    for 7s as b2 [
      narrate("languages comes first: the codes, their labels, and a star on the default. One entry is its own default.")
      revealBlock("#cf-code-languages")
      spotlight("#cf-tok-star")
      callout("#cf-cl-languages", "xx-XX codes, unique; compiles to language + availableLanguages")
      demo("#cf-fx-languages")
    ]

    // Beat 3 — default imports: this file's layout, styles and locales (14–22 s)
    for 8s as b3 [
      narrate("Four default imports, one of each: layout, styles, provider, locales. Paths are relative to the file.")
      revealBlock("#cf-code-defaults")
      spotlight("#cf-tok-styles")
      callout("#cf-cl-defaults", "one of each per file; ./ or ../ only — no absolute paths or URLs")
      demo("#cf-fx-defaults")
    ]

    // Beat 4 — named imports: REAL, cfPlaceHint places @hint (22–30 s)
    for 8s as b4 [
      narrate("A named import gives an asset a name. An HTML file becomes a string you can place with @name.")
      revealBlock("#cf-code-named")
      spotlight("#cf-tok-import")
      callout("#cf-cl-named", "names are unique per file; contextual keywords allowed as names")
      cfPlaceHint()
      demo("#cf-fx-hint")
    ]

    // Beat 5 — library imports, aliases and private actions (30–38 s)
    for 8s as b5 [
      narrate("import { … } from a library: public actions by name, renamed with as. private keeps a helper at home.")
      revealBlock("#cf-code-lib")
      spotlight("#cf-tok-private")
      callout("#cf-cl-lib", "errors: private import, missing action, name clash with an operation or a local action, circular libraries")
      demo("#cf-fx-lib")
    ]

    // Beat 6 — extensions: the host module this file declares (38–46 s)
    for 8s as b6 [
      narrate("extensions declares your own JavaScript: operations, controllers and functions the module exports. The compiler trusts the declaration; the bundle carries the module.")
      revealBlock("#cf-code-ext")
      spotlight("#cf-tok-ext")
      callout("#cf-cl-ext", "one per program; .js .mjs .ts .mts .jsx .tsx; no Eligius names; params name, name?, name: type")
      demo("#cf-fx-ext")
    ]

    // Beat 7 — comments and JSDoc (46–53 s)
    for 7s as b7 [
      narrate("Comments: // and /* */. A /** doc */ with @param above an action becomes hover documentation.")
      revealBlock("#cf-code-doc")
      spotlight("#cf-tok-jsdoc")
      callout("#cf-cl-doc", "typing /** + Enter above an action fills the template (Chapter 07)")
      demo("#cf-fx-doc")
    ]

    // Beat 8 — keywords: reserved vs contextual (53–60 s)
    for 7s as b8 [
      narrate("Sixteen reserved words can't be names. Every other keyword is contextual — fine as a parameter or const; action names are stricter. Hub.")
      revealBlock("#cf-code-keywords")
      spotlight("#cf-tok-reserved")
      callout("#cf-cl-keywords", "reserved: action break const continue else endable false for if import null on sequence stagger timeline true · action names accept fewer: plain names and the verbs (play, toggle, run, key, …), so action loop() fails (Chapter 07)")
      demo("#cf-fx-done")
    ]
  }
}

// ===========================================================================
// Chapter 06 — Engine Reach (#ch5). Reaching past the timeline clock into the
// engine's runtime: the eventbus (broadcastEvent), event-driven `on event`
// actions, interactions and `on key`, controllers (nine of them), locales with
// a LabelController, and a host operation. REAL: the ping button (wired in
// on enter with `run`, beat 3), the chapter's own interactions and keys (beats
// 4–5), the greeting label and its two language buttons (beat 7) and the clock
// host.js stamps (beat 8). Everything on enter attaches, on leave removes —
// and switches the language back to en-US, which would persist otherwise.
// ===========================================================================
timeline "Engine Reach" in "#stage" using raf {

  // setup: show this chapter + narration + progress on enter; wire back, Esc,
  // space and r, the ping button, the two language buttons and the greeting's
  // LabelController. On leave: back to en-US, unwire the chapter's own
  // controllers, then hide, reset the view and unwire the skeleton.
  on enter [
    enterChapter("#ch5")
    on click "#c5-to-hub" navigate "Hub"
    on key "Escape" navigate "Hub"
    on key "space" toggle
    on key "r" run replayChapter("#ch5")
    on click "#c5-fx-ping" run ch5BroadcastPing() // the live button, wired once per visit
    on click "#c5-fx-lang-nl" run ch5Dutch() // live language switch
    on click "#c5-fx-lang-en" run ch5English()
    selectElement("#c5-fx-label-text") // the span, not the panel: LabelController replaces its element's content
    addController("LabelController", "tour.greeting") // real locales
  ]
  on leave [
    broadcastEvent(["en-US"], "language-change") // the language persists across timelines: back to the default
    with "#c5-fx-ping" { removeControllerFromElement("DOMEventListenerController") }
    with "#c5-fx-lang-nl" { removeControllerFromElement("DOMEventListenerController") }
    with "#c5-fx-lang-en" { removeControllerFromElement("DOMEventListenerController") }
    with "#c5-fx-label-text" { removeControllerFromElement("LabelController") }
    leaveChapter("#ch5", "#c5-to-hub")
  ]

  sequence each [ clearSpots() ] {
    // Beat 1 — five doors past the clock (0–7 s)
    for 7s as b1 [
      narrate("Everything so far fired on the clock. A presentation also reacts — to clicks, keys, events, and to your own code. That's engine reach.")
      revealBlock("#c5-code-overview")
      callout("#c5-cl-over", "five doors past the clock")
      demo("#c5-fx-doors")
    ]

    // Beat 2 — the eventbus: one bus, many listeners (7–15 s)
    for 8s as b2 [
      narrate("broadcastEvent puts a message on the engine's bus. Whoever listens for that name reacts: your on event handlers, controllers — and the engine itself.")
      revealBlock("#c5-code-eventbus")
      spotlight("#c5-tok-bcast")
      callout("#c5-cl-bus", "one bus, many listeners; request-timeline-uri is a broadcast the engine answers by switching")
      demo("#c5-fx-bus")
    ]

    // Beat 3 ⭐ — on event: REAL, the button is live since on enter (15–24 s)
    for 9s as b3 [
      narrate("An on event action runs when its event fires, not at a time. Click the button: it broadcasts tour-ping, and this handler reveals the panel.")
      revealBlock("#c5-code-onevent")
      spotlight("#c5-tok-onevent")
      callout("#c5-cl-on", 'params map to eventArgs by position · topic "x" namespaces · parentheses optional with no params')
      demo("#c5-fx-bus")
    ]

    // Beat 4 — interactions: this chapter's own on enter (24–32 s)
    for 8s as b4 [
      // &lt; &gt;: narrate writes HTML, so a literal <event> would be a tag
      narrate("on &lt;event&gt; on an element runs a verb: navigate, play, pause, toggle, stop, seek, or run an action. The hub cards and this button are written that way.")
      revealBlock("#c5-code-interact")
      spotlight("#c5-tok-run")
      callout("#c5-cl-interact", "any DOM event name; run arguments must be compile-time values; the action starts with eventTarget, eventKey and its arguments — nothing from the surrounding block")
      demo("#c5-fx-interact")
    ]

    // Beat 5 — keys: this chapter's own on key lines (32–40 s)
    for 8s as b5 [
      narrate("on key binds keyboard shortcuts — Escape takes you to the hub, space pauses, r replays, in every chapter.")
      revealBlock("#c5-code-keys")
      spotlight("#c5-tok-key")
      callout("#c5-cl-keys", "a KeyboardController; unknown names are errors; input fields are ignored")
      demo("#c5-fx-keys")
    ]

    // Beat 6 — controllers: what both forms desugar to (40–48 s)
    for 8s as b6 [
      narrate("Under both forms sits a controller: lasting behaviour attached to a selected element. This is what on click desugars to — one of nine.")
      revealBlock("#c5-code-controller")
      spotlight("#c5-tok-ctrl")
      callout("#c5-cl-ctrl", "DOMEventListener · Keyboard · Label · Lottie · MutationObserver · Navigation · Progressbar · Routing · Subtitles")
      demo("#c5-fx-ctrl")
    ]

    // Beat 7 ⭐ — locales: REAL, the LabelController on enter attached (48–57 s)
    for 9s as b7 [
      narrate("locales make text translatable: a LabelController renders a key in the active language. This label — and the hub title — are real ones: click nl-NL and it switches.")
      revealBlock("#c5-code-label")
      spotlight("#c5-tok-loc")
      callout("#c5-cl-loc", "completion and did-you-mean on the key; Chapter 07 has the editor")
      demo("#c5-fx-label")
    ]

    // Beat 8 — host code: REAL, ch5Stamp calls host.js (57–65 s)
    for 8s as b8 [
      narrate("Your own JavaScript reaches in too: a host operation is called like a built-in. This clock was stamped by host.js just now.")
      revealBlock("#c5-code-host")
      spotlight("#c5-tok-host")
      callout("#c5-cl-host", "bundled by --bundle, dev, smoke and the preview (trusted workspaces)")
      ch5Stamp()
      demo("#c5-fx-host")
    ]

    // Beat 9 — recap: the hub was built from these (65–73 s)
    for 8s as b9 [
      narrate("Eventbus, on event, interactions, controllers, locales, host code — the hub, its title and every click you made were built from these. Hub.")
      revealBlock("#c5-code-recap")
      spotlight("#c5-tok-recap")
      demo("#c5-fx-done")
    ]
  }
}

// ===========================================================================
// Chapter 07 — The Editor (#ch6). The VS Code extension, one beat per feature:
// install, diagnostics, CSS and selector checks, dataflow fixes, completion,
// signature help and inlay hints, hovers and JSDoc, navigation, the Outline,
// snippets / format / block labels, the preview, runtime errors and Eligius
// lint, the Timeline view, locales / New Presentation / compile, settings.
// The effect pane is a REENACTMENT: a CSS-built mock of VS Code (there is no
// language server at runtime) whose strings are copied from the providers or
// captured with `eligian check` and the real LSP providers; the sources are
// listed per beat in storyboards/chapter-07-the-editor.md. Sub-steps inside a
// beat are timed `at eK.start + Ns` events after the sequence. The one live
// tie-in: opened in the extension's preview, beat 11 shows what you look at.
// ===========================================================================
timeline "The Editor" in "#stage" using raf {

  // setup: show this chapter + narration + progress on enter; wire back, Esc,
  // space and r. On leave: hide, reset the view, unwire.
  on enter [
    enterChapter("#ch6")
    on click "#c6-to-hub" navigate "Hub"
    on key "Escape" navigate "Hub"
    on key "space" toggle
    on key "r" run replayChapter("#ch6")
  ]
  on leave [
    leaveChapter("#ch6", "#c6-to-hub")
  ]

  sequence each [ clearSpots() ] {
    // Beat 1 — install: the editor is the other half (0–8 s)
    for 8s as e1 [
      narrate("The other half of Eligian is the editor. Install the extension and every .eligian file gets highlighting, checking, completion, hover, a preview — all of which wrote this tour. What follows is a mock-up with the real texts.")
      revealBlock("#c6-code-why")
      spotlight("#c6-tok-why")
      callout("#c6-cl-e1", "one extension: highlighting, diagnostics, completion, hovers, preview, Timeline view, Locale Editor")
      demo("#c6-fx-editor")
    ]

    // Beat 2 — validation + Problems (8–15 s)
    for 7s as e2 [
      narrate("Syntax errors speak plainly, and every semantic rule — imports, names, arguments, events, timelines — lands in Problems while you type.")
      revealBlock("#c6-code-syntax")
      spotlight("#c6-tok-syntax")
      callout("#c6-cl-e2", "one line per syntax error: a keyword used as a name is explained, expected tokens read as words")
      demo("#c6-fx-problems")
    ]

    // Beat 3 ⭐ — CSS & selectors (15–22 s)
    for 7s as e3 [
      narrate("Every class and selector is checked against your CSS and your layout — even when it travels through an action parameter. Typo one: a squiggle, a suggestion, a one-click fix.")
      revealBlock("#c6-code-css")
      spotlight("#c6-tok-css")
      callout("#c6-cl-e3", "CSS ∪ layout for selectors; CSS only for class names · eligian.validation.selectorNotInLayout")
      demo("#c6-fx-css")
    ]

    // Beat 4 — dataflow + quick fix (22–29 s)
    for 7s as e4 [
      narrate("The dataflow check knows what each block carries. A missing selected element gets a fix: Insert selectElement, or Add target.")
      revealBlock("#c6-code-dataflow")
      spotlight("#c6-tok-dataflow")
      callout("#c6-cl-e4", "an action's hover lists what it needs from the caller")
      demo("#c6-fx-dataflow")
    ]

    // Beat 5 — completion (29–36 s)
    for 7s as e5 [
      narrate("Type and the editor knows what fits: operations, your actions, controllers, CSS classes and ids, DOM events, keys, timeline names, label keys, even whole event skeletons.")
      revealBlock("#c6-code-complete")
      spotlight("#c6-tok-complete")
      callout("#c6-cl-e5", "the list depends on the place: a call, a navigate target, a key, a controller name")
      demo("#c6-fx-complete")
    ]

    // Beat 6 — signature help + inlay hints (36–43 s)
    for 7s as e6 [
      narrate("Inside a call the signature follows your cursor; resolved times and parameter names sit in the code as inlay hints.")
      revealBlock("#c6-code-hints")
      spotlight("#c6-tok-hints")
      callout("#c6-cl-e6", "settings: eligian.inlayHints.*")
      demo("#c6-fx-hints")
    ]

    // Beat 7 — hover + JSDoc (43–50 s)
    for 7s as e7 [
      narrate("Hover anything: an operation's docs from Eligius, your action's JSDoc, the CSS rule behind a class. Type /** above an action and the template writes itself.")
      revealBlock("#c6-code-jsdoc")
      spotlight("#c6-tok-jsdoc")
      callout("#c6-cl-e7", "call: the JSDoc · definition: what call sites are checked for · timeline: its header")
      demo("#c6-fx-hover")
    ]

    // Beat 8 — navigation (50–57 s)
    for 7s as e8 [
      narrate("F12 jumps from navigate to the timeline, from a selector to the CSS rule or the layout element. Shift+F12 finds references across .eligian, CSS and HTML; F2 renames a timeline everywhere.")
      revealBlock("#c6-code-nav")
      spotlight("#c6-tok-nav")
      callout("#c6-cl-e8", "eligian.codeLens.cssReferences · Find Eligian References in CSS and HTML files")
      demo("#c6-fx-nav")
    ]

    // Beat 9 — outline (57–64 s)
    for 7s as e9 [
      narrate("The Outline lists timelines with their lifecycle blocks and events at their resolved times — Ctrl+Shift+O jumps to any beat.")
      revealBlock("#c6-code-outline")
      spotlight("#c6-tok-outline")
      callout("#c6-cl-e9", "also the breadcrumbs and Go to Symbol")
      demo("#c6-fx-outline")
    ]

    // Beat 10 — snippets, format, block labels (64–71 s)
    for 7s as e10 [
      narrate("Snippets scaffold an action, a timeline, a chapter. Format Document tidies whitespace only. And every start and end block is labelled in the margin; a range rewrites itself as start for duration in one click.")
      revealBlock("#c6-code-format")
      spotlight("#c6-tok-format")
      callout("#c6-cl-e10", "the same rules as eligian fmt")
      demo("#c6-fx-format")
    ]

    // Beat 11 — preview (71–78 s); hot reload is told, not shown
    for 7s as e11 [
      narrate("Ctrl+K V opens the preview: the real engine in a webview, recompiled on every save and keeping its place; CSS, layout, locale and host-module edits reload live. Scrub, pick a timeline or a language, or start from a line.")
      revealBlock("#c6-code-preview")
      spotlight("#c6-tok-preview")
      callout("#c6-cl-e11", "eligian.preview.highlightActiveEvents · eligian.codeLens.preview")
      demo("#c6-fx-preview")
    ]

    // Beat 12 — runtime errors + lint (78–85 s)
    for 7s as e12 [
      narrate("An engine error during preview becomes a diagnostic on the operation that failed, with Go to Source; a compile error shows in the preview, with Retry Compilation. And Eligius' own lint runs 200 ms after you stop typing.")
      revealBlock("#c6-code-runtime")
      spotlight("#c6-tok-runtime")
      callout("#c6-cl-e12", "source 'eligius-runtime' / 'Eligius lint'; setting eligian.validation.eligiusLint")
      demo("#c6-fx-runtime")
    ]

    // Beat 13 — timeline view (85–92 s)
    for 7s as e13 [
      narrate("The Eligian panel draws each timeline as a Gantt chart: a bar per event at its resolved time, the preview's playhead moving through. Click a bar to jump to its source; double-click to preview from there.")
      revealBlock("#c6-code-gantt")
      spotlight("#c6-tok-gantt")
      callout("#c6-cl-e13", "bars named by their labels; stagger rows by their item")
      demo("#c6-fx-gantt")
    ]

    // Beat 14 — locales, new presentation, compile (92–99 s)
    for 7s as e14 [
      narrate("Edit translations in the Locale Editor — Ctrl+Click the locales path, or Open With. New Presentation writes a starter project; Compile Current File writes the JSON beside your file.")
      revealBlock("#c6-code-locales")
      spotlight("#c6-tok-locales")
      // &lt; &gt;: callout writes HTML, so a literal <key> would be a tag
      callout("#c6-cl-e14", "label quick fixes: Create labels file · Create label entry 'hub.title' · Use '&lt;key&gt;'")
      demo("#c6-fx-locale")
    ]

    // Beat 15 — settings + recap (99–106 s)
    for 7s as e15 [
      narrate("Ten settings tune it: lint, selector checks, playhead highlights, CodeLenses, inlay hints. Concise, checked, live — that's Eligian in the editor. Hub.")
      revealBlock("#c6-code-recap")
      spotlight("#c6-tok-recap")
      callout("#c6-cl-e15", "Settings › Extensions › Eligian")
      demo("#c6-fx-done")
    ]
  }

  // Sub-steps: the popups and panels inside a beat's frame appear one after
  // the other (revealCard adds .in; resetChapter removes it on leave and replay).
  at e2.start + 2s for 5s [ revealCard("#c6-pop-problems") ]
  at e3.start + 2s for 5s [ revealCard("#c6-pop-css-diag") ]
  at e3.start + 4s for 3s [ revealCard("#c6-pop-css-fix") ]
  at e4.start + 2s for 5s [ revealCard("#c6-pop-df-hover") ]
  at e4.start + 4s for 3s [ revealCard("#c6-pop-df-fix") ]
  at e5.start + 2s for 5s [ revealCard("#c6-pop-complete-nav") ]
  at e5.start + 4s for 3s [ revealCard("#c6-pop-complete-more") ]
  at e6.start + 2s for 5s [ revealCard("#c6-pop-sig") ]
  at e6.start + 4s for 3s [ revealCard("#c6-fx-hints .ide-inlay") ]
  at e7.start + 1.5s for 5.5s [ revealCard("#c6-pop-hover-def") ]
  at e7.start + 3s for 4s [ revealCard("#c6-pop-hover-tl") ]
  at e7.start + 4.5s for 2.5s [ revealCard("#c6-pop-jsdoc") ]
  at e8.start + 2s for 5s [ revealCard("#c6-pop-nav-lens") ]
  at e8.start + 4s for 3s [ revealCard("#c6-pop-nav-peek") ]
  at e8.start + 5.5s for 1.5s [ revealCard("#c6-pop-nav-fix") ]
  at e9.start + 2s for 5s [ revealCard("#c6-fx-outline .ide-pop") ]
  at e10.start + 2s for 5s [ revealCard("#c6-pop-snippets") ]
  at e10.start + 4s for 3s [ revealCard("#c6-fx-format .ide-blocklabel") ]
  at e10.start + 5.5s for 1.5s [ revealCard("#c6-pop-refactor") ]
  at e11.start + 2s for 5s [ revealCard("#c6-pop-lens") ]
  at e11.start + 4s for 3s [ revealCard("#c6-pop-playhead") ]
  at e11.start + 5.5s for 1.5s [ revealCard("#c6-pop-debug") ]
  at e12.start + 2s for 5s [ revealCard("#c6-pop-toast") ]
  at e12.start + 4s for 3s [ revealCard("#c6-pop-lint") ]
  at e12.start + 5.5s for 1.5s [ revealCard("#c6-pop-compile") ]
  at e13.start + 2s for 5s [ revealCard("#c6-gantt-playhead") ]
  at e14.start + 2s for 5s [ revealCard("#c6-pop-locale-table") ]
  at e14.start + 4s for 3s [ revealCard("#c6-pop-starters") ]
  at e14.start + 5.5s for 1.5s [ revealCard("#c6-pop-langblock") ]
}

// ===========================================================================
// Chapter 08 — The Command Line (#chc). The eligian CLI, one beat per command:
// install, init, compile, bundle, the eligian map, check, check formats and
// Eligius lint, smoke, dev, fmt, exit codes. The effect pane is a
// REENACTMENT: a CSS-built mock terminal whose every line is real output of
// node packages/cli/bin/cli.js (sources per beat in
// storyboards/chapter-08-the-command-line.md). REAL: each beat's output lines
// and later commands appear through a stagger after the sequence (Chapter 04's
// tool at work in the CLI chapter); the end blocks are left out, resetChapter
// clears .in on leave and replay.
// ===========================================================================
timeline "The Command Line" in "#stage" using raf {

  // setup: show this chapter + narration + progress on enter; wire back, Esc,
  // space and r. On leave: hide, reset the view, unwire.
  on enter [
    enterChapter("#chc")
    on click "#cc-to-hub" navigate "Hub"
    on key "Escape" navigate "Hub"
    on key "space" toggle
    on key "r" run replayChapter("#chc")
  ]
  on leave [
    leaveChapter("#chc", "#cc-to-hub")
  ]

  sequence each [ clearSpots() ] {
    // Beat 1 — install: npm, the two bins, version and help (0–7 s)
    for 7s as t1 [
      narrate("The compiler is also a command: eligian on npm, Node 22.12 or later. Install it, or run it once with npx.")
      revealBlock("#cc-code-install")
      spotlight("#cc-tok-install")
      callout("#cc-cl-t1", "two bins: eligian and eligian-cli · -V / --version · -h / --help · help [command]")
      demo("#cc-fx-install")
    ]

    // Beat 2 — init: a starter project, and the refusal to overwrite one (7–15 s)
    for 8s as t2 [
      narrate("eligian init writes a starter that already checks clean: blank, chapters, video or library, with layout, styles, locales, a package.json and a README.")
      revealBlock("#cc-code-init")
      spotlight("#cc-tok-init")
      callout("#cc-cl-t2", "-t / --template · --title (default: from the directory name) · --force overwrites")
      demo("#cc-fx-init")
    ]

    // Beat 3 — compile: the default command, --check, and a parse error (15–23 s)
    for 8s as t3 [
      narrate("eligian file.eligian compiles to Eligius JSON next to the file. Dash o picks the output, dash for stdout; --check only validates; --minify, --no-optimize, -q and -v adjust the rest.")
      revealBlock("#cc-code-compile")
      spotlight("#cc-tok-compile")
      callout("#cc-cl-t3", "-o - writes the JSON to stdout · eligian file is short for eligian compile file")
      demo("#cc-fx-compile")
    ]

    // Beat 4 — bundle: a standalone presentation directory (23–31 s)
    for 8s as t4 [
      narrate("--bundle writes a standalone presentation: index.html, bundle.js, your assets, small images inlined, only the Eligius pieces you use. --force overwrites, --sourcemap and --inline-threshold tune it.")
      revealBlock("#cc-code-bundle")
      spotlight("#cc-tok-bundle")
      callout("#cc-cl-t4", "next to the input as tour.bundle/, or -o a directory · --inline-threshold in bytes (51200 by default)")
      demo("#cc-fx-bundle")
    ]

    // Beat 5 — the eligian map: compiled ids back to source lines (31–38 s)
    for 7s as t5 [
      narrate("--eligian-map also writes the map from every compiled action and operation back to its source line — the same map the preview and smoke build in memory to point at the failing operation, written to a file for your own tools.")
      revealBlock("#cc-code-map")
      spotlight("#cc-tok-map")
      callout("#cc-cl-t5", "compiled actions and operations → .eligian source locations")
      demo("#cc-fx-map")
    ]

    // Beat 6 — check: every error and warning of many files (38–47 s)
    for 9s as t6 [
      narrate("eligian check reports every error and warning of many files — globs, directories, exclusions — and fails on warnings when you tell it to.")
      revealBlock("#cc-code-check")
      spotlight("#cc-tok-check")
      callout("#cc-cl-t6", "patterns: files, directories, globs, !excludes; node_modules skipped")
      demo("#cc-fx-check")
    ]

    // Beat 7 — check formats and Eligius lint (47–55 s)
    for 8s as t7 [
      narrate("Four output formats: pretty, json, sarif for code scanning, github for pull-request annotations. Eligius' own configuration lint runs too unless --no-lint; --selector-not-in-layout adds the layout check.")
      revealBlock("#cc-code-formats")
      spotlight("#cc-tok-formats")
      callout("#cc-cl-t7", "sarif 2.1.0 · github workflow commands")
      demo("#cc-fx-formats")
    ]

    // Beat 8 — smoke: every timeline played headlessly on the real engine (55–64 s)
    for 9s as t8 [
      narrate("eligian smoke plays every timeline headlessly on the real engine: enter, every start and end, leave — and reports what fails at its source line. --strict also flags selectors that match nothing.")
      revealBlock("#cc-code-smoke")
      spotlight("#cc-tok-smoke")
      callout("#cc-cl-t8", "--strict: selectElement selectors that match no element · --format pretty, github or json")
      demo("#cc-fx-smoke")
    ]

    // Beat 9 — dev: the bundle in the browser, rebuilt on change (64–72 s)
    for 8s as t9 [
      narrate("eligian dev serves the bundle and rebuilds on every change: a CSS edit swaps styles in place, anything else reloads and resumes at the same position. Build errors show as an overlay.")
      revealBlock("#cc-code-dev")
      spotlight("#cc-tok-dev")
      callout("#cc-cl-t9", "only files under the entry's directory are watched · a taken --port moves to the next free one")
      demo("#cc-fx-dev")
    ]

    // Beat 10 — fmt: whitespace only, --check by default (72–80 s)
    for 8s as t10 [
      narrate("eligian fmt checks formatting — whitespace only, the editor's Format Document rules — and --write applies it. CI runs it on every example.")
      revealBlock("#cc-code-fmt")
      spotlight("#cc-tok-fmt")
      callout("#cc-cl-t10", "--format text or github · a file with syntax errors is left alone (exit 2)")
      demo("#cc-fx-fmt")
    ]

    // Beat 11 — exit codes (80–87 s)
    for 7s as t11 [
      narrate("Exit codes you can script on: 0 clean, 1 findings or a failed compile, 2 usage errors of check, smoke, fmt, dev and init, 3 I/O. The repo's CI checks, plays and format-checks every example this way. Hub.")
      revealBlock("#cc-code-exit")
      spotlight("#cc-tok-exit")
      callout("#cc-cl-t11", "commander's own usage errors (a missing argument, an unknown option) exit 1")
      demo("#cc-fx-exit")
    ]
  }

  // The terminal output: one REAL stagger per beat over its output lines and
  // later commands, in display order (a second command types after the first
  // one's output). Each event ends by its beat's end.
  // beat 1 (install): 12 lines from t1.start + 1.5s, 250ms apart
  stagger 250ms [
    "#cc-out-install-1",
    "#cc-out-install-2",
    "#cc-out-install-3",
    "#cc-out-install-4",
    "#cc-cmd-install-2",
    "#cc-out-install-5",
    "#cc-cmd-install-3",
    "#cc-out-install-6",
    "#cc-out-install-7",
    "#cc-out-install-8",
    "#cc-out-install-9",
    "#cc-cmd-install-4"
  ] at t1.start + 1.5s for 2.5s [
    selectElement(@@item)
    addClass("in")
  ]

  // beat 2 (init): 10 lines from t2.start + 1.5s, 250ms apart
  stagger 250ms [
    "#cc-out-init-1",
    "#cc-out-init-2",
    "#cc-out-init-3",
    "#cc-out-init-4",
    "#cc-out-init-5",
    "#cc-out-init-6",
    "#cc-cmd-init-2",
    "#cc-out-init-7",
    "#cc-out-init-8",
    "#cc-cmd-init-3"
  ] at t2.start + 1.5s for 4s [
    selectElement(@@item)
    addClass("in")
  ]

  // beat 3 (compile): 20 lines from t3.start + 1.5s, 250ms apart
  stagger 250ms [
    "#cc-out-compile-1",
    "#cc-cmd-compile-2",
    "#cc-out-compile-2",
    "#cc-cmd-compile-3",
    "#cc-out-compile-3",
    "#cc-out-compile-4",
    "#cc-out-compile-5",
    "#cc-out-compile-6",
    "#cc-out-compile-7",
    "#cc-out-compile-8",
    "#cc-out-compile-9",
    "#cc-out-compile-10",
    "#cc-out-compile-11",
    "#cc-out-compile-12",
    "#cc-out-compile-13",
    "#cc-out-compile-14",
    "#cc-out-compile-15",
    "#cc-out-compile-16",
    "#cc-out-compile-17",
    "#cc-cmd-compile-4"
  ] at t3.start + 1.5s for 1.5s [
    selectElement(@@item)
    addClass("in")
  ]

  // beat 4 (bundle): 10 lines from t4.start + 1.5s, 250ms apart
  stagger 250ms [
    "#cc-out-bundle-1",
    "#cc-out-bundle-2",
    "#cc-out-bundle-3",
    "#cc-out-bundle-4",
    "#cc-cmd-bundle-2",
    "#cc-out-bundle-5",
    "#cc-out-bundle-6",
    "#cc-cmd-bundle-3",
    "#cc-out-bundle-7",
    "#cc-cmd-bundle-4"
  ] at t4.start + 1.5s for 4s [
    selectElement(@@item)
    addClass("in")
  ]

  // beat 5 (map): 7 lines from t5.start + 1.5s, 250ms apart
  stagger 250ms [
    "#cc-out-map-1",
    "#cc-out-map-2",
    "#cc-cmd-map-2",
    "#cc-out-map-3",
    "#cc-cmd-map-3",
    "#cc-out-map-4",
    "#cc-cmd-map-4"
  ] at t5.start + 1.5s for 4s [
    selectElement(@@item)
    addClass("in")
  ]

  // beat 6 (check): 8 lines from t6.start + 1.5s, 250ms apart
  stagger 250ms [
    "#cc-out-check-1",
    "#cc-out-check-2",
    "#cc-out-check-3",
    "#cc-out-check-4",
    "#cc-out-check-5",
    "#cc-cmd-check-2",
    "#cc-out-check-6",
    "#cc-cmd-check-3"
  ] at t6.start + 1.5s for 5.5s [
    selectElement(@@item)
    addClass("in")
  ]

  // beat 7 (formats): 20 lines from t7.start + 1.5s, 250ms apart
  stagger 250ms [
    "#cc-out-formats-1",
    "#cc-out-formats-2",
    "#cc-cmd-formats-2",
    "#cc-out-formats-3",
    "#cc-out-formats-4",
    "#cc-out-formats-5",
    "#cc-out-formats-6",
    "#cc-out-formats-7",
    "#cc-out-formats-8",
    "#cc-out-formats-9",
    "#cc-out-formats-10",
    "#cc-out-formats-11",
    "#cc-out-formats-12",
    "#cc-out-formats-13",
    "#cc-cmd-formats-3",
    "#cc-out-formats-14",
    "#cc-out-formats-15",
    "#cc-out-formats-16",
    "#cc-out-formats-17",
    "#cc-cmd-formats-4"
  ] at t7.start + 1.5s for 1.5s [
    selectElement(@@item)
    addClass("in")
  ]

  // beat 8 (smoke): 19 lines from t8.start + 1.5s, 250ms apart
  stagger 250ms [
    "#cc-out-smoke-1",
    "#cc-out-smoke-2",
    "#cc-out-smoke-3",
    "#cc-out-smoke-4",
    "#cc-out-smoke-5",
    "#cc-out-smoke-6",
    "#cc-out-smoke-7",
    "#cc-out-smoke-8",
    "#cc-out-smoke-9",
    "#cc-out-smoke-10",
    "#cc-out-smoke-11",
    "#cc-out-smoke-12",
    "#cc-cmd-smoke-2",
    "#cc-out-smoke-13",
    "#cc-out-smoke-14",
    "#cc-out-smoke-15",
    "#cc-out-smoke-16",
    "#cc-out-smoke-17",
    "#cc-cmd-smoke-3"
  ] at t8.start + 1.5s for 3s [
    selectElement(@@item)
    addClass("in")
  ]

  // beat 9 (dev): 11 lines from t9.start + 1.5s, 250ms apart
  stagger 250ms [
    "#cc-out-dev-1",
    "#cc-out-dev-2",
    "#cc-out-dev-3",
    "#cc-out-dev-4",
    "#cc-out-dev-5",
    "#cc-out-dev-6",
    "#cc-out-dev-7",
    "#cc-out-dev-8",
    "#cc-out-dev-9",
    "#cc-out-dev-10",
    "#cc-cmd-dev-2"
  ] at t9.start + 1.5s for 4s [
    selectElement(@@item)
    addClass("in")
  ]

  // beat 10 (fmt): 19 lines from t10.start + 1.5s, 250ms apart
  stagger 250ms [
    "#cc-out-fmt-1",
    "#cc-out-fmt-2",
    "#cc-out-fmt-3",
    "#cc-out-fmt-4",
    "#cc-out-fmt-5",
    "#cc-out-fmt-6",
    "#cc-out-fmt-7",
    "#cc-out-fmt-8",
    "#cc-out-fmt-9",
    "#cc-out-fmt-10",
    "#cc-out-fmt-11",
    "#cc-out-fmt-12",
    "#cc-out-fmt-13",
    "#cc-cmd-fmt-2",
    "#cc-out-fmt-14",
    "#cc-out-fmt-15",
    "#cc-cmd-fmt-3",
    "#cc-out-fmt-16",
    "#cc-cmd-fmt-4"
  ] at t10.start + 1.5s for 2s [
    selectElement(@@item)
    addClass("in")
  ]

  // beat 11 (exit): 12 lines from t11.start + 1.5s, 250ms apart
  stagger 250ms [
    "#cc-out-exit-1",
    "#cc-cmd-exit-2",
    "#cc-out-exit-2",
    "#cc-cmd-exit-3",
    "#cc-out-exit-3",
    "#cc-cmd-exit-4",
    "#cc-out-exit-4",
    "#cc-cmd-exit-5",
    "#cc-out-exit-5",
    "#cc-cmd-exit-6",
    "#cc-out-exit-6",
    "#cc-cmd-exit-7"
  ] at t11.start + 1.5s for 2.5s [
    selectElement(@@item)
    addClass("in")
  ]

  // the end card, after the exit codes
  at t11.start + 5s for 2s [ demo("#cc-fx-done") ]
}
