{
  "name": "eligian",
  "description": "Base workspace package",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "pnpm --filter \"./packages/**\" run clean",
    "watch": "tsc -b tsconfig.build.json --watch",
    "build": "pnpm -r build",
    "build:clean": "pnpm clean && pnpm build",
    "langium:generate": "pnpm --filter @eligian/language langium:generate",
    "langium:watch": "pnpm --filter @eligian/language langium:watch",
    "generate:html-metadata": "tsx scripts/generate-html-metadata.ts",
    "test": "pnpm -r test",
    "test:coverage:ci": "pnpm -r test:coverage:ci",
    "test:coverage": "tsx tools/pruned-coverage.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "ci": "biome ci .",
    "typecheck": "tsc -b tsconfig.build.json",
    "effect:check": "pnpm effect:check:language && pnpm effect:check:cli",
    "effect:check:language": "effect-tsgo diagnostics --project packages/language/tsconfig.src.json --format text --strict",
    "effect:check:cli": "effect-tsgo diagnostics --project packages/cli/tsconfig.json --format text --strict",
    "effect:patch": "effect-tsgo patch --typescript"
  },
  "dependencies": {
    "effect": "4.0.5",
    "eligius": "3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@effect/tsgo": "0.53.3",
    "@types/node": "26.6.5",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "5.0.4",
    "esbuild": "0.28.2",
    "shx": "0.4.0",
    "tsx": "4.23.15",
    "typegraph-mcp": "^0.9.56",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
